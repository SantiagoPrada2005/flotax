{
  "id": "/",
  "name": "FlotaX — Gestión y Alquiler de Flota",
  "short_name": "FlotaX",
  "description": "Sistema operativo móvil y gestión perimetral en tiempo real para el alquiler y control de flotas de vehículos.",
  "start_url": "/home",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#EDEDED",
  "theme_color": "#EDEDED",
  "lang": "es-CO",
  "dir": "ltr",
  "prefer_related_applications": false,
  "categories": ["business", "productivity", "transportation"],
  "icons": [
    {
      "src": "/favicon.svg",
      "sizes": "any",
