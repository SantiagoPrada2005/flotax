---
import LayoutApp from '@/layouts/LayoutApp.astro';
import RentalWizardFlow from '@/components/alquiler/RentalWizardFlow';
import {
  obtenerVehiculoAsync,
  listarVehiculos,
  obtenerBloquesNoDisponiblesD1,
  obtenerLocalPorSlugOId,
  obtenerLocalCatalogoPorDefecto,
  type VehiculoItem,
} from '@/lib/flota';
import { obtenerEstadoDocumentalVehiculoD1 } from '@/lib/flota/disponibilidad';
import { listarResumenesDocumentalesFlotaD1 } from '@/lib/documentos-vehiculo';
import { resolveClientTimeContext } from '@/lib/time/client-time';
import {
  normalizarPoliticaDomicilio,
  PATIO_COORDENADAS_DEFECTO,
  resolverTokenMapboxPublico,
  sonCoordenadasValidas,
  type UbicacionPatio,
} from '@/lib/ubicacion';
import { politicasLocal } from '@/db/schema';
import { eq } from 'drizzle-orm';
import { env } from 'cloudflare:workers';
import { getDb } from '@/lib/db';

const { id } = Astro.params;
const db = env.DB ? getDb(env.DB) : undefined;
const localCautivo = Astro.locals.localCaptacion;
const vehiculo = id
  ? await obtenerVehiculoAsync(id, db, localCautivo?.id)
  : undefined;

if (!vehiculo || vehiculo.estado === 'FUERA_SERVICIO') {
  return Astro.redirect(localCautivo ? `/c/${localCautivo.slug}` : '/catalogo');
}

const { dateString: hoyISO } = resolveClientTimeContext(Astro.request);
const localId = localCautivo?.id ?? vehiculo.localId ?? undefined;

const [bloques, estadoDocumental, localInfo] = await Promise.all([
  db ? obtenerBloquesNoDisponiblesD1(db, vehiculo.id, hoyISO, 180) : Promise.resolve([]),
  db
    ? obtenerEstadoDocumentalVehiculoD1(db, vehiculo.id, vehiculo.categoria, hoyISO)
    : Promise.resolve({
        tieneVencidos: false,
        faltantesSinCarga: [],
        vencidos: [],
        requiereRtm: vehiculo.categoria !== 'PATINETA',
        exentoPorLey2486: vehiculo.categoria === 'PATINETA',
        bloqueadoPorDocumentos: false,
        motivoBloqueo: null,
      }),
  (async () =>
    localCautivo ??
    (localId ? await obtenerLocalPorSlugOId(localId, db) : null) ??
    (await obtenerLocalCatalogoPorDefecto(db)))(),
]);

const desdeParam = Astro.url.searchParams.get('desde') ?? undefined;
const hastaParam = Astro.url.searchParams.get('hasta') ?? undefined;
const stepParam = Astro.url.searchParams.get('step');
const pasoInicial =
  stepParam === '2'
    ? 2
    : stepParam === '3'
      ? 3
      : stepParam === '4'
        ? 4
        : stepParam === '5'
          ? 5
          : 1;

const usuarioLocals = Astro.locals.usuario;
const usuarioActual = usuarioLocals
  ? {
      id: usuarioLocals.id,
      nombre: usuarioLocals.nombre,
      correo: usuarioLocals.correo,
      telefono: usuarioLocals.telefono,
      tipoDocumento: usuarioLocals.tipoDocumento,
      numeroDocumento: usuarioLocals.numeroDocumento,
    }
  : null;

const sedeNombre = localInfo.nombre;
const patioUbicacion: UbicacionPatio = {
  nombre: localInfo.nombre,
  direccion: localInfo.direccion ?? null,
  ciudad: localInfo.ciudad ?? 'Medellín',
  lat:
    typeof localInfo.latitud === 'number' &&
    typeof localInfo.longitud === 'number' &&
    sonCoordenadasValidas(localInfo.latitud, localInfo.longitud)
      ? localInfo.latitud
      : PATIO_COORDENADAS_DEFECTO.lat,
  lng:
    typeof localInfo.latitud === 'number' &&
    typeof localInfo.longitud === 'number' &&
    sonCoordenadasValidas(localInfo.latitud, localInfo.longitud)
      ? localInfo.longitud
      : PATIO_COORDENADAS_DEFECTO.lng,
};

let politicaRow = null;
if (db && localInfo.id) {
  try {
    const rows = await db
      .select()
      .from(politicasLocal)
      .where(eq(politicasLocal.localId, localInfo.id))
      .limit(1);
    politicaRow = rows[0] ?? null;
  } catch {
    politicaRow = null;
  }
}

const politicaDomicilio = normalizarPoliticaDomicilio(politicaRow);
const mapboxPublicToken = resolverTokenMapboxPublico(env);
const esAdminOperador = Astro.locals.modoPortal === 'ADMIN';

const vehiculoBloqueadoDocs = Boolean(
  estadoDocumental.bloqueadoPorDocumentos ||
    estadoDocumental.tieneVencidos ||
    estadoDocumental.faltantesSinCarga.length > 0
);

let vehiculosSimilares: VehiculoItem[] = [];
if (vehiculoBloqueadoDocs && !esAdminOperador) {
  const fechaEvalInicio = desdeParam ?? hoyISO;
  const fechaEvalFin = hastaParam ?? fechaEvalInicio;
  const candidatos = await listarVehiculos(db, {
    localId: localInfo.id,
    soloDisponibles: true,
    desde: fechaEvalInicio,
    hasta: fechaEvalFin,
    hoyISO,
  });
  const otros = candidatos.filter((v) => v.id !== vehiculo.id);
  const resumenesDocs =
    db && otros.length > 0
      ? await listarResumenesDocumentalesFlotaD1(db, otros, hoyISO)
      : {};
  const habilitados = otros.filter(
    (v) => !resumenesDocs[v.id]?.bloqueadoPorDocumentos
  );
  const mismaCategoria = habilitados.filter(
    (v) => v.categoria === vehiculo.categoria
  );
  const otrasCategorias = habilitados.filter(
    (v) => v.categoria !== vehiculo.categoria
  );
  vehiculosSimilares = [...mismaCategoria, ...otrasCategorias].slice(0, 3);
}

const estadoDocumentalSeguro =
  esAdminOperador || !vehiculoBloqueadoDocs
    ? estadoDocumental
    : {
        tieneVencidos: false,
        faltantesSinCarga: [],
        vencidos: [],
        requiereRtm: false,
        exentoPorLey2486: false,
        bloqueadoPorDocumentos: true,
        motivoBloqueo: null,
      };
---

<LayoutApp
  title={`Alquilar ${vehiculo.marca} ${vehiculo.modelo} — FlotaX`}
  noindex={true}
  hideNav={true}
  navVariant="client"
>
  <div class="mx-auto flex min-h-dvh w-full max-w-md sm:max-w-xl flex-col justify-between px-3.5 py-2.5 safe-top safe-bottom">
    <RentalWizardFlow
      client:load
      vehiculo={vehiculo}
      hoyISO={hoyISO}
      bloquesIniciales={bloques}
      usuarioActual={usuarioActual}
      fechaInicioInicial={desdeParam}
      fechaFinInicial={hastaParam}
      pasoInicial={pasoInicial}
      estadoDocumental={estadoDocumentalSeguro}
      esAdminOperador={esAdminOperador}
      telefonoEncargado={localInfo.telefono}
      vehiculosSimilares={vehiculosSimilares}
      localId={localInfo.id}
      sedeNombre={sedeNombre}
      patioUbicacion={patioUbicacion}
      politicaDomicilio={politicaDomicilio}
      mapboxPublicToken={mapboxPublicToken}
    />
  </div>
</LayoutApp>
