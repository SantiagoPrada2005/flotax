---
import LayoutApp from '@/layouts/LayoutApp.astro';
import RentalWizardFlow from '@/components/alquiler/RentalWizardFlow';
import { obtenerVehiculoAsync } from '@/lib/flota';
import { resolveClientTimeContext } from '@/lib/time/client-time';
import { env } from 'cloudflare:workers';
import { getDb } from '@/lib/db';

const { id } = Astro.params;
const db = env.DB ? getDb(env.DB) : undefined;
const localCautivo = Astro.locals.localCaptacion;
const vehiculo = id
  ? await obtenerVehiculoAsync(id, db, localCautivo?.id)
  : undefined;

if (!vehiculo) {
  return Astro.redirect(localCautivo ? `/c/${localCautivo.slug}` : '/catalogo');
}

const { dateString: hoyISO } = resolveClientTimeContext(Astro.request);

const desdeParam = Astro.url.searchParams.get('desde') ?? undefined;
const hastaParam = Astro.url.searchParams.get('hasta') ?? undefined;
const stepParam = Astro.url.searchParams.get('step');
const pasoInicial =
  stepParam === '2' ? 2 : stepParam === '3' ? 3 : stepParam === '4' ? 4 : 1;

const usuarioLocals = Astro.locals.usuario;
const usuarioActual = usuarioLocals
  ? {
      id: usuarioLocals.id,
      nombre: usuarioLocals.nombre,
      correo: usuarioLocals.correo,
      telefono: usuarioLocals.telefono,
      tipoDocumento: usuarioLocals.tipoDocumento,
      numeroDocumento: usuarioLocals.numeroDocumento,
    }
  : null;
---

<LayoutApp
  title={`Alquilar ${vehiculo.marca} ${vehiculo.modelo} — FlotaX`}
  noindex={true}
  hideNav={true}
  navVariant="client"
>
  <div class="mx-auto flex min-h-dvh w-full max-w-md sm:max-w-xl flex-col justify-between px-3.5 py-2.5 safe-top safe-bottom">
    <RentalWizardFlow
      client:load
      vehiculo={vehiculo}
      hoyISO={hoyISO}
      usuarioActual={usuarioActual}
      fechaInicioInicial={desdeParam}
      fechaFinInicial={hastaParam}
      pasoInicial={pasoInicial}
    />
  </div>
</LayoutApp>
