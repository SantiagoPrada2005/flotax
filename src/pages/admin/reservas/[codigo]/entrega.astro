---
import LayoutAdmin from '@/layouts/LayoutAdmin.astro';
import EntregaVehiculoWizardIsland from '@/components/reservas/entrega-wizard/EntregaVehiculoWizardIsland';
import { obtenerReservaPorCodigoD1 } from '@/lib/flota/repositorio-reservas';
import { obtenerDetalleReservaAdminD1 } from '@/lib/flota/detalle-reserva-admin';
import { env } from 'cloudflare:workers';
import { getDb } from '@/lib/db';
import {
  PERMISOS,
  tienePermiso,
  validarAccesoReservaLectura,
} from '@/lib/auth';
import { cuentasFinancieras } from '@/db/schema';
import { and, eq } from 'drizzle-orm';

const { codigo } = Astro.params;

if (!codigo) {
  return Astro.redirect('/admin/reservas');
}

const codigoNorm = codigo.toUpperCase();
const usuario = Astro.locals.usuario;
if (!usuario || !usuario.localActivo) {
  return Astro.redirect('/admin/reservas');
}

const sujeto = {
  rol: usuario.localActivo.rol,
  esSuperAdmin: usuario.esSuperAdmin,
  permisosConcedidos: usuario.localActivo.permisosConcedidos,
  permisosRevocados: usuario.localActivo.permisosRevocados,
};

if (!tienePermiso(sujeto, PERMISOS.CONTRATOS_CREAR)) {
  return Astro.redirect(`/admin/reservas/${codigoNorm}`);
}

const db = env.DB ? getDb(env.DB) : undefined;
const reservaInicial = await obtenerReservaPorCodigoD1(db, codigoNorm);

if (!reservaInicial) {
  return Astro.redirect('/admin/reservas');
}

const tieneAcceso = validarAccesoReservaLectura(reservaInicial, usuario);
if (!tieneAcceso) {
  return new Response('Acceso no autorizado a esta reserva.', { status: 403 });
}

if (reservaInicial.estado !== 'CONFIRMADA') {
  return Astro.redirect(`/admin/reservas/${codigoNorm}`);
}

const cuentasLocal =
  db && usuario.localActivo.id
    ? await db
        .select({
          id: cuentasFinancieras.id,
          nombre: cuentasFinancieras.nombre,
          tipo: cuentasFinancieras.tipo,
        })
        .from(cuentasFinancieras)
        .where(
          and(
            eq(cuentasFinancieras.localId, usuario.localActivo.id),
            eq(cuentasFinancieras.activo, true)
          )
        )
        .all()
    : [];
const detalleAdminEntrega = await obtenerDetalleReservaAdminD1(
  db,
  codigoNorm,
  usuario.localActivo.id
);
---

<LayoutAdmin
  title={`Entrega de Vehículo #${codigoNorm} — FlotaX`}
  hideNav={true}
  activeTab="search"
>
  <EntregaVehiculoWizardIsland
    client:load
    reservaInicial={reservaInicial}
    cuentasFinancieras={cuentasLocal}
    fotosEntregaIniciales={detalleAdminEntrega.fotosEntrega}
  />
</LayoutAdmin>
