---
import LayoutAdmin from '@/layouts/LayoutAdmin.astro';
import MisReservasHub from '@/components/reservas/MisReservasHub';
import { resolveClientTimeContext } from '@/lib/time/client-time';
import { env } from 'cloudflare:workers';
import { getDb } from '@/lib/db';
import { listarReservasD1 } from '@/lib/flota/repositorio-reservas';
import { listarVehiculos, obtenerLocalPorSlugOId, LOCAL_CANONICO_DEFECTO } from '@/lib/flota';
import { cuentasFinancieras } from '@/db/schema';
import { and, eq } from 'drizzle-orm';

const { dateString: hoyISO } = resolveClientTimeContext(Astro.request);
const abrirNuevaInicial = Astro.url.searchParams.get('nueva') === '1';

const usuario = Astro.locals.usuario;
const db = env.DB ? getDb(env.DB) : undefined;
const localActivoSesion = usuario?.localActivo;
const localContexto =
  (localActivoSesion
    ? await obtenerLocalPorSlugOId(localActivoSesion.id, db)
    : null) ??
  (localActivoSesion
    ? {
        id: localActivoSesion.id,
        nombre: localActivoSesion.nombre,
        slug: localActivoSesion.slug,
        ciudad: 'Medellín',
        direccion: null,
        telefono: null,
      }
    : LOCAL_CANONICO_DEFECTO);

const initialReservas = await listarReservasD1(db, {
  localId: localContexto.id,
});
const vehiculosDisponibles = await listarVehiculos(db, {
  localId: localContexto.id,
});

const cuentasLocal =
  db && usuario?.localActivo
    ? await db
        .select({
          id: cuentasFinancieras.id,
          nombre: cuentasFinancieras.nombre,
          tipo: cuentasFinancieras.tipo,
        })
        .from(cuentasFinancieras)
        .where(
          and(
            eq(cuentasFinancieras.localId, usuario.localActivo.id),
            eq(cuentasFinancieras.activo, true)
          )
        )
    : [];
---

<LayoutAdmin title="FlotaX — Reservas de Patio" activeTab="search">
  <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8 py-2 sm:py-4">
    <MisReservasHub
      client:load
      hoyISO={hoyISO}
      modo="admin"
      abrirNuevaInicial={abrirNuevaInicial}
      initialReservas={initialReservas}
      vehiculosDisponibles={vehiculosDisponibles}
      cuentasFinancieras={cuentasLocal}
    />
  </div>
</LayoutAdmin>
