---
import LayoutAdmin from '@/layouts/LayoutAdmin.astro';
import MisReservasHub from '@/components/reservas/MisReservasHub';
import { resolveClientTimeContext } from '@/lib/time/client-time';

const { dateString: hoyISO } = resolveClientTimeContext(Astro.request);
const abrirNuevaInicial = Astro.url.searchParams.get('nueva') === '1';
---

<LayoutAdmin title="FlotaX — Reservas de Patio" activeTab="search">
  <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8 py-2 sm:py-4">
    <MisReservasHub
      client:load
      hoyISO={hoyISO}
      modo="admin"
      abrirNuevaInicial={abrirNuevaInicial}
    />
  </div>
</LayoutAdmin>
