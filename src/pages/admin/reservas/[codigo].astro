---
import LayoutAdmin from '@/layouts/LayoutAdmin.astro';
import AlquilerDetalleView from '@/components/reservas/AlquilerDetalleView';
import { obtenerReservaClientePorCodigo } from '@/lib/flota';
import { obtenerReservaPorCodigoD1 } from '@/lib/flota/repositorio-reservas';
import { resolveClientTimeContext } from '@/lib/time/client-time';
import { env } from 'cloudflare:workers';
import { getDb } from '@/lib/db';
import {
  validarAccesoReservaLectura,
  calcularCapacidadesOperacionAlquiler,
} from '@/lib/auth';
import { cuentasFinancieras } from '@/db/schema';
import { and, eq } from 'drizzle-orm';

const { codigo } = Astro.params;

if (!codigo) {
  return Astro.redirect('/admin/reservas');
}

const usuario = Astro.locals.usuario;
if (!usuario || !usuario.localActivo) {
  return Astro.redirect('/admin/reservas');
}

const { dateString: hoyISO } = resolveClientTimeContext(Astro.request);
const db = env.DB ? getDb(env.DB) : undefined;
let reservaInicial = await obtenerReservaPorCodigoD1(db, codigo);
if (!reservaInicial) {
  reservaInicial = obtenerReservaClientePorCodigo(codigo, null, hoyISO) ?? null;
}

if (!reservaInicial) {
  return Astro.redirect('/admin/reservas');
}

const tieneAcceso = validarAccesoReservaLectura(reservaInicial, usuario);
if (!tieneAcceso) {
  return new Response('Acceso no autorizado a esta reserva.', { status: 403 });
}

let cuentasLocal: Array<{ id: string; nombre: string; tipo: string }> = [];
if (db && usuario.localActivo.id) {
  cuentasLocal = await db
    .select({
      id: cuentasFinancieras.id,
      nombre: cuentasFinancieras.nombre,
      tipo: cuentasFinancieras.tipo,
    })
    .from(cuentasFinancieras)
    .where(
      and(
        eq(cuentasFinancieras.localId, usuario.localActivo.id),
        eq(cuentasFinancieras.activo, true)
      )
    )
    .all();
}

const capacidades = calcularCapacidadesOperacionAlquiler(usuario.localActivo);
---

<LayoutAdmin
  title={`Operación #${codigo.toUpperCase()} — FlotaX`}
  showBack={true}
  backHref="/admin/reservas"
  activeTab="search"
>
  <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8 py-2 sm:py-6">
    <AlquilerDetalleView
      client:load
      codigo={codigo.toUpperCase()}
      reservaInicial={reservaInicial}
      hoyISO={hoyISO}
      modo="admin"
      capacidades={capacidades}
      cuentasFinancieras={cuentasLocal}
    />
  </div>
</LayoutAdmin>
