---
import LayoutAdmin from "@/layouts/LayoutAdmin.astro";
import { resolveClientTimeContext } from "@/lib/time/client-time";
import BentoHeroCard from "@/components/dashboard/BentoHeroCard.astro";
import BentoMetricsGrid from "@/components/dashboard/BentoMetricsGrid.astro";
import AlquilerEnProcesoCard from "@/components/dashboard/AlquilerEnProcesoCard";
import LocalCatalogShareCard from "@/components/flota/LocalCatalogShareCard";
import {
  listarVehiculos,
  obtenerLocalPorSlugOId,
  LOCAL_CANONICO_DEFECTO,
  asegurarConfiguracionBaseLocal,
} from "@/lib/flota";
import { FLOTA_CANONICA } from "@/lib/flota/mock-vehiculos";
import { env } from "cloudflare:workers";
import { getDb } from "@/lib/db";

const timeContext = resolveClientTimeContext(Astro.request);
const usuario = Astro.locals.usuario;
const db = env.DB ? getDb(env.DB) : undefined;

const localActivoSesion = usuario?.localActivo;
const localContexto =
  (localActivoSesion
    ? await obtenerLocalPorSlugOId(localActivoSesion.id, db)
    : null) ??
  (localActivoSesion
    ? {
        id: localActivoSesion.id,
        nombre: localActivoSesion.nombre,
        slug: localActivoSesion.slug,
        ciudad: "Medellín",
        direccion: null,
        telefono: null,
      }
    : LOCAL_CANONICO_DEFECTO);

if (db && localContexto.id) {
  await asegurarConfiguracionBaseLocal(db, localContexto.id);
}

const vehiculosDb = await listarVehiculos(db, { localId: localContexto.id });
// Si la base de datos local aún no tiene vehículos insertados, usamos la flota canónica mock
const vehiculosPatio = vehiculosDb.length > 0 ? vehiculosDb : FLOTA_CANONICA;

const totalUnits = vehiculosPatio.length;
// Mocks para que las métricas reflejen operatividad realista solicitada por el líder
const activasCount = 2; // Corresponde a los 2 alquileres en proceso iniciales
const disponiblesCount = Math.max(0, totalUnits - activasCount);
const occupancyPercentage =
  totalUnits > 0 ? Math.round((activasCount / totalUnits) * 100) : 0;

// Monto de liquidaciones acumuladas del día para la caja del turno
const totalValorDia = 1450000;
const revenueFormatted = new Intl.NumberFormat("es-CO", {
  style: "currency",
  currency: "COP",
  maximumFractionDigits: 0,
}).format(totalValorDia);
---

<LayoutAdmin title="FlotaX — Panel General" activeTab="home">
  <div class="mx-auto w-full max-w-md sm:max-w-xl lg:max-w-5xl xl:max-w-7xl px-4 py-3 sm:py-5 space-y-4 sm:space-y-5">
    <h1 class="sr-only">Panel General — {localContexto.nombre}</h1>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 sm:gap-5 items-start">
      <!-- Columna 1: Pulso Operativo (Ocupación + Caja del Turno + Disponibles) -->
      <div class="space-y-4 sm:space-y-5">
        <!-- Bento Grid Section 1: Hero Progress Card (Ocupación de Flota) -->
        <BentoHeroCard
          occupancyPercentage={occupancyPercentage}
          dateLabel={timeContext.dateString}
          activeUnits={activasCount}
          totalUnits={totalUnits}
          yardName={localContexto.nombre}
        />

        <!-- Bento Grid Section 2: Caja Turno (Horizontal Ancho Completo) + Disponibles (Fila Propia) -->
        <BentoMetricsGrid
          availableCount={disponiblesCount}
          availableLabel="Disponibles"
          availableTrend={`${disponiblesCount} en patio`}
          revenueAmount={revenueFormatted}
          revenueTrend="Capacidad/día"
          shiftStatus="ABIERTA"
        />
      </div>

      <!-- Columna 2: Operaciones en Tiempo Real (Alquiler en Proceso + Catálogo Digital) -->
      <div class="space-y-4 sm:space-y-5">
        <!-- Bento Grid Section 3: Alquiler en Proceso (Tiempo Real / Polling) -->
        <AlquilerEnProcesoCard client:load />

        <!-- Opción Principal: Enlace del Catálogo del Local con Progressive Disclosure -->
        <LocalCatalogShareCard
          client:load
          local={localContexto}
          unidadesCount={vehiculosPatio.length}
          compact={true}
        />
      </div>
    </div>
  </div>
</LayoutAdmin>
