---
import { env } from 'cloudflare:workers';
import LayoutAdmin from '@/layouts/LayoutAdmin.astro';
import { getDb } from '@/lib/db';
import { obtenerLocalPorSlugOId, listarVehiculos } from '@/lib/flota';
import { resolveClientTimeContext } from '@/lib/time/client-time';
import { getYardMetricsSnapshot, obtenerDatosMetricasLocalD1 } from '@/lib/metricas';
import MetricsInteractiveHub from '@/components/dashboard/MetricsInteractiveHub';

const usuario = Astro.locals.usuario;
const localActivo = usuario?.localActivo;
if (!localActivo?.id) {
  return Astro.redirect('/admin');
}

const timeContext = resolveClientTimeContext(Astro.request);
const operatorName = usuario?.nombre ?? 'Operador';
const db = env.DB ? getDb(env.DB) : undefined;

const localContexto =
  (await obtenerLocalPorSlugOId(localActivo.id, db)) ?? {
    id: localActivo.id,
    nombre: localActivo.nombre,
    slug: localActivo.slug,
    ciudad: 'Medellín',
    direccion: null,
    telefono: null,
  };

const [vehiculos, datosD1] = await Promise.all([
  listarVehiculos(db, {
    localId: localContexto.id,
    hoyISO: timeContext.dateString,
  }),
  obtenerDatosMetricasLocalD1(
    db,
    localContexto.id,
    timeContext.dateString,
    timeContext.timezone
  ),
]);

const snapshot = getYardMetricsSnapshot({
  yardName: localContexto.nombre,
  cityLabel: localContexto.ciudad,
  operatorName,
  timezone: timeContext.timezone,
  dateLabel: timeContext.dateString,
  hoyISO: timeContext.dateString,
  vehiculos,
  datosD1,
});
---

<LayoutAdmin title="FlotaX — Métricas y Telemetría" activeTab="metrics">
  <div class="mx-auto w-full max-w-5xl xl:max-w-7xl 2xl:max-w-[1536px] px-4 sm:px-6 py-4 space-y-5">
    <header class="flex flex-wrap items-center justify-between gap-3 border-b border-[#9CA3AF]/35 pb-3.5">
      <div class="min-w-0">
        <p class="text-xs sm:text-sm font-semibold uppercase tracking-wider text-[#4B5563] truncate">
          {localContexto.nombre} • {timeContext.dateString}
        </p>
        <h1 class="mt-0.5 font-display text-2xl sm:text-3xl font-black tracking-tight text-[#111827]">
          Métricas y telemetría
        </h1>
      </div>

      <span class="inline-flex shrink-0 items-center gap-2 rounded-full bg-[#111827] px-3.5 py-2 text-xs font-bold text-white shadow-xs">
        <span class="h-2 w-2 rounded-full bg-status-success"></span>
        <span>Patio en línea</span>
      </span>
    </header>

    <MetricsInteractiveHub client:load snapshot={snapshot} />
  </div>
</LayoutAdmin>
