---
import LayoutAdmin from '@/layouts/LayoutAdmin.astro';
import VehicleFormIsland from '@/components/flota/VehicleFormIsland';
---

<LayoutAdmin
  title="FlotaX — Nueva Unidad en Alquiler"
  activeTab="fleet"
  showBack={true}
  backHref="/admin/flota"
>
  <div class="mx-auto w-full max-w-md sm:max-w-xl px-4 py-3 space-y-4">
    <!-- Header de la Pantalla -->
    <header class="pt-1 pb-1">
      <p class="text-xs font-semibold uppercase tracking-wider text-[#4B5563]">
        Inventario de Patio
      </p>
      <div class="mt-0.5 flex items-baseline justify-between">
        <h1 class="font-display text-2xl font-black tracking-tight text-[#111827] sm:text-3xl">
          Dar de Alta Vehículo
        </h1>
        <span class="inline-flex items-center gap-1 rounded-full bg-emerald-50 px-2.5 py-0.5 text-[11px] font-bold text-emerald-700 border border-emerald-200">
          <span class="h-1.5 w-1.5 rounded-full bg-emerald-600"></span>
          Nuevo Ingreso
        </span>
      </div>
      <p class="mt-1 text-xs text-[#4B5563]">
        Registre una nueva unidad disponible para ser ofrecida en alquiler y visualizada en catálogo.
      </p>
    </header>

    <!-- Formulario de Alta y Configuración -->
    <VehicleFormIsland client:load />
  </div>
</LayoutAdmin>
