---
import LayoutAdmin from '@/layouts/LayoutAdmin.astro';
import FleetInventoryManager from '@/components/flota/FleetInventoryManager';
import {
  listarVehiculos,
  obtenerLocalPorSlugOId,
  LOCAL_CANONICO_DEFECTO,
} from '@/lib/flota';
import { env } from 'cloudflare:workers';
import { getDb } from '@/lib/db';

const db = env.DB ? getDb(env.DB) : undefined;
const localActivoSesion = Astro.locals.usuario?.localActivo;
const localContexto =
  (localActivoSesion
    ? await obtenerLocalPorSlugOId(localActivoSesion.id, db)
    : null) ??
  (localActivoSesion
    ? {
        id: localActivoSesion.id,
        nombre: localActivoSesion.nombre,
        slug: localActivoSesion.slug,
        ciudad: 'Medellín',
        direccion: null,
        telefono: null,
      }
    : LOCAL_CANONICO_DEFECTO);

const vehiculos = await listarVehiculos(db, { localId: localContexto.id });
---

<LayoutAdmin title="FlotaX — Flota" activeTab="fleet">
  <div class="mx-auto w-full max-w-5xl px-4 sm:px-6 py-3 space-y-5">
    <h1 class="sr-only">Flota de vehículos — {localContexto.nombre}</h1>

    <FleetInventoryManager
      initialVehiculos={vehiculos}
      nuevaUnidadHref="/admin/flota/nuevo"
      client:load
    />
  </div>
</LayoutAdmin>
