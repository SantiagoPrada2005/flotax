---
import LayoutAdmin from '@/layouts/LayoutAdmin.astro';
import FleetInventoryManager from '@/components/flota/FleetInventoryManager';
import LocalCatalogShareCard from '@/components/flota/LocalCatalogShareCard';
import {
  listarVehiculos,
  obtenerLocalPorSlugOId,
  LOCAL_CANONICO_DEFECTO,
} from '@/lib/flota';
import { env } from 'cloudflare:workers';
import { getDb } from '@/lib/db';

const db = env.DB ? getDb(env.DB) : undefined;
const localActivoSesion = Astro.locals.usuario?.localActivo;
const localContexto =
  (localActivoSesion
    ? await obtenerLocalPorSlugOId(localActivoSesion.id, db)
    : null) ??
  (localActivoSesion
    ? {
        id: localActivoSesion.id,
        nombre: localActivoSesion.nombre,
        slug: localActivoSesion.slug,
        ciudad: 'Medellín',
        direccion: null,
        telefono: null,
      }
    : LOCAL_CANONICO_DEFECTO);

const vehiculos = await listarVehiculos(db, { localId: localContexto.id });
---

<LayoutAdmin title="FlotaX — Control de Flota" activeTab="fleet">
  <div class="mx-auto w-full max-w-md sm:max-w-xl px-4 py-3 space-y-4">
    <!-- Header de Módulo -->
    <header class="pt-1 pb-1">
      <p class="text-xs font-semibold uppercase tracking-wider text-[#4B5563]">
        Operaciones de Patio • {localContexto.nombre}
      </p>
      <div class="mt-0.5 flex items-baseline justify-between">
        <h1 class="font-display text-2xl font-black tracking-tight text-[#111827] sm:text-3xl">
          Flota de Vehículos
        </h1>
        <a
          href="/admin/flota/nuevo"
          class="inline-flex min-h-[40px] items-center gap-1.5 rounded-full bg-[#111827] px-3.5 py-1.5 text-xs font-semibold text-white shadow-sm transition hover:bg-[#1F2937] active:scale-95"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="h-3.5 w-3.5">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
          </svg>
          Nueva Unidad
        </a>
      </div>
    </header>

    <!-- Centro de Compartición del Catálogo Exclusivo del Local -->
    <LocalCatalogShareCard
      client:load
      local={localContexto}
      unidadesCount={vehiculos.length}
    />

    <!-- Gestor Reactivo de Flota e Inventario -->
    <FleetInventoryManager initialVehiculos={vehiculos} client:load />
  </div>
</LayoutAdmin>
