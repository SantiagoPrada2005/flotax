---
import LayoutAdmin from '@/layouts/LayoutAdmin.astro';
---

<LayoutAdmin title="FlotaX — Control de Flota" activeTab="fleet">
  <div class="mx-auto w-full max-w-md sm:max-w-xl px-4 py-3 space-y-4">
    <!-- Header de Módulo -->
    <header class="pt-1 pb-1">
      <p class="text-xs font-semibold uppercase tracking-wider text-[#4B5563]">
        Operaciones de Patio
      </p>
      <div class="mt-0.5 flex items-baseline justify-between">
        <h1 class="font-display text-2xl font-black tracking-tight text-[#111827] sm:text-3xl">
          Flota de Vehículos
        </h1>
        <a
          href="/admin/flota/nuevo"
          class="inline-flex min-h-[40px] items-center gap-1.5 rounded-full bg-[#111827] px-3.5 py-1.5 text-xs font-semibold text-white shadow-sm transition hover:bg-[#1F2937] active:scale-95"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="h-3.5 w-3.5">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
          </svg>
          Nueva Unidad
        </a>
      </div>
    </header>

    <!-- Resumen de Estados de Flota -->
    <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
      <div class="rounded-[20px] bg-white p-3.5 border border-[#9CA3AF]/30 shadow-xs">
        <span class="text-[10px] font-semibold uppercase tracking-wider text-emerald-700">Disponibles</span>
        <p class="mt-1 font-display text-2xl font-black text-[#111827]">14</p>
        <span class="text-[10px] text-[#4B5563]">Listos para entrega</span>
      </div>
      <div class="rounded-[20px] bg-white p-3.5 border border-[#9CA3AF]/30 shadow-xs">
        <span class="text-[10px] font-semibold uppercase tracking-wider text-blue-700">En Alquiler</span>
        <p class="mt-1 font-display text-2xl font-black text-[#111827]">6</p>
        <span class="text-[10px] text-[#4B5563]">Contratos activos</span>
      </div>
      <div class="rounded-[20px] bg-white p-3.5 border border-[#9CA3AF]/30 shadow-xs">
        <span class="text-[10px] font-semibold uppercase tracking-wider text-amber-700">Mantenimiento</span>
        <p class="mt-1 font-display text-2xl font-black text-[#111827]">2</p>
        <span class="text-[10px] text-[#4B5563]">En revisión técnica</span>
      </div>
      <div class="rounded-[20px] bg-white p-3.5 border border-[#9CA3AF]/30 shadow-xs">
        <span class="text-[10px] font-semibold uppercase tracking-wider text-rose-700">Fuera Servicio</span>
        <p class="mt-1 font-display text-2xl font-black text-[#111827]">0</p>
        <span class="text-[10px] text-[#4B5563]">Bajas operativas</span>
      </div>
    </div>

    <!-- Lista de Unidades en Patio -->
    <div class="rounded-[28px] bg-white p-5 border border-[#9CA3AF]/30 shadow-md">
      <div class="flex items-center justify-between pb-3 border-b border-[#9CA3AF]/20">
        <h2 class="font-display text-base font-bold text-[#111827]">Unidades en Patio Norte</h2>
        <span class="text-xs text-[#4B5563]">22 unidades registradas</span>
      </div>
      <p class="mt-4 text-xs text-[#4B5563] text-center py-6">
        Catálogo operativo en tiempo real conectado a Cloudflare D1.
      </p>
    </div>
  </div>
</LayoutAdmin>
