---
import LayoutAdmin from '@/layouts/LayoutAdmin.astro';
import FleetInventoryManager from '@/components/flota/FleetInventoryManager';
import { listarVehiculos } from '@/lib/flota';
import { env } from 'cloudflare:workers';
import { getDb } from '@/lib/db';

const db = env.DB ? getDb(env.DB) : undefined;
const vehiculos = await listarVehiculos(db);
---

<LayoutAdmin title="FlotaX — Control de Flota" activeTab="fleet">
  <div class="mx-auto w-full max-w-5xl px-4 sm:px-6 py-4 space-y-6">
    <!-- Header de Módulo -->
    <header class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pt-1 pb-1">
      <div>
        <div class="flex items-center gap-2">
          <span class="h-2 w-2 rounded-full bg-[#111827]"></span>
          <p class="font-mono text-[10px] font-bold uppercase tracking-wider text-[#4B5563]">
            Operaciones de Patio · FlotaX Core
          </p>
        </div>
        <h1 class="mt-1 font-display text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-[#111827]">
          Flota de Vehículos
        </h1>
        <p class="mt-1 text-xs font-medium text-[#4B5563]">
          Control perimetral de inventario, disponibilidad operativa y mantenimiento en patio.
        </p>
      </div>

      <div class="flex items-center gap-2 shrink-0">
        <a
          href="/admin/flota/nuevo"
          class="ios-press-bounce inline-flex min-h-[44px] items-center gap-2 rounded-full bg-[#111827] px-5 py-2.5 text-xs font-bold text-white shadow-xs transition hover:bg-[#1F2937]"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            class="h-4 w-4"
          >
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
          </svg>
          <span>Nueva Unidad</span>
        </a>
      </div>
    </header>

    <!-- Gestor Reactivo de Flota e Inventario -->
    <FleetInventoryManager initialVehiculos={vehiculos} client:load />
  </div>
</LayoutAdmin>
