---
import LayoutApp from '@/layouts/LayoutApp.astro';
import LocalCatalogShowcase from '@/components/flota/LocalCatalogShowcase';
import {
  listarVehiculos,
  obtenerLocalCatalogoPorDefecto,
} from '@/lib/flota';
import { env } from 'cloudflare:workers';
import { getDb } from '@/lib/db';

const db = env.DB ? getDb(env.DB) : undefined;
const localCautivo = Astro.locals.localCaptacion;
const local = localCautivo ?? (await obtenerLocalCatalogoPorDefecto(db));
const vehiculos = await listarVehiculos(db, { localId: local.id });
---

<LayoutApp
  title={`${local.nombre} — Catálogo de Vehículos`}
  activeTab="home"
  navVariant="client"
>
  <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8 py-3 sm:py-5 pb-28">
    <LocalCatalogShowcase
      client:load
      local={local}
      initialVehiculos={vehiculos}
      esPerimetroCerrado={Boolean(localCautivo)}
    />
  </div>
</LayoutApp>
