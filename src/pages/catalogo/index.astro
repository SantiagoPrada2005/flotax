---
import LayoutApp from "@/layouts/LayoutApp.astro";
---

<LayoutApp
  title="FlotaX — Catálogo de Vehículos"
  activeTab="home"
  navVariant="client"
>
  <div class="mx-auto w-full max-w-md sm:max-w-xl px-4 py-3 space-y-4">
    <!-- Header de Catálogo -->
    <header class="pt-1 pb-1">
      <p class="text-xs font-semibold uppercase tracking-wider text-[#4B5563]">
        Explorar Flota
      </p>
      <div class="mt-0.5 flex items-baseline justify-between">
        <h1
          class="font-display text-2xl font-black tracking-tight text-[#111827] sm:text-3xl"
        >
          Vehículos Disponibles
        </h1>
      </div>
    </header>

    <!-- Barra de Búsqueda y Filtros Rápidos -->
    <div class="flex items-center gap-2">
      <div class="relative flex-1">
        <input
          type="text"
          placeholder="Buscar auto, moto o patineta..."
          class="w-full rounded-full border border-[#9CA3AF]/40 bg-white px-4 py-2.5 text-base text-[#111827] placeholder:text-[#9CA3AF] shadow-xs focus:outline-none focus:ring-2 focus:ring-[#111827]"
        />
      </div>
      <button
        type="button"
        aria-label="Filtrar catálogo"
        class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-white border border-[#9CA3AF]/40 text-[#111827] shadow-xs transition hover:scale-105 active:scale-95"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          class="h-4.5 w-4.5"
        >
          <line x1="4" x2="20" y1="6" y2="6"></line>
          <line x1="8" x2="16" y1="12" y2="12"></line>
          <line x1="10" x2="14" y1="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <!-- Píldoras de Categorías -->
    <div class="flex items-center gap-2 overflow-x-auto pb-1 no-scrollbar">
      <button
        type="button"
        class="rounded-full bg-[#111827] px-4 py-1.5 text-xs font-semibold text-white shadow-sm shrink-0"
      >
        Todos
      </button>
      <button
        type="button"
        class="rounded-full bg-white border border-[#9CA3AF]/40 px-4 py-1.5 text-xs font-semibold text-[#4B5563] shrink-0 hover:text-[#111827]"
      >
        Sedán & SUV
      </button>
      <button
        type="button"
        class="rounded-full bg-white border border-[#9CA3AF]/40 px-4 py-1.5 text-xs font-semibold text-[#4B5563] shrink-0 hover:text-[#111827]"
      >
        Motos
      </button>
      <button
        type="button"
        class="rounded-full bg-white border border-[#9CA3AF]/40 px-4 py-1.5 text-xs font-semibold text-[#4B5563] shrink-0 hover:text-[#111827]"
      >
        Patinetas E.
      </button>
      <button
        type="button"
        class="rounded-full bg-white border border-[#9CA3AF]/40 px-4 py-1.5 text-xs font-semibold text-[#4B5563] shrink-0 hover:text-[#111827]"
      >
        Utilitarios
      </button>
    </div>

    <!-- Mosaico de Catálogo -->
    <div
      class="rounded-[28px] bg-white p-6 border border-[#9CA3AF]/30 shadow-md text-center py-10"
    >
      <p class="text-sm font-semibold text-[#111827]">
        Catálogo de Flota en Vivo
      </p>
      <p class="mt-1 text-xs text-[#4B5563]">
        Explora vehículos disponibles para alquilar por día, semana o mes con
        reserva inmediata.
      </p>
    </div>
  </div>
</LayoutApp>
