---
import LayoutApp from '@/layouts/LayoutApp.astro';
import PerfilEditorCard from '@/components/perfil/PerfilEditorCard';
import { env } from 'cloudflare:workers';
import { getDb } from '@/lib/db';
import { obtenerLocalesMembresia, type MembresiaLocalResumen } from '@/lib/auth/session';
import { verificacionesIdentidad } from '@/db/schema';
import { eq, desc } from 'drizzle-orm';

const usuario = Astro.locals.usuario;

if (!usuario) {
  return Astro.redirect('/login');
}

let membresias: MembresiaLocalResumen[] = [];
let estadoVerificacion = 'PENDIENTE';

if (env.DB) {
  const db = getDb(env.DB);
  membresias = await obtenerLocalesMembresia(db, usuario.id);

  const verif = await db
    .select({ estado: verificacionesIdentidad.estado })
    .from(verificacionesIdentidad)
    .where(eq(verificacionesIdentidad.usuarioId, usuario.id))
    .orderBy(desc(verificacionesIdentidad.creadoEn))
    .limit(1);

  if (verif.length > 0 && verif[0]) {
    estadoVerificacion = verif[0].estado;
  }
}

const perfilData = {
  id: usuario.id,
  nombre: usuario.nombre,
  correo: usuario.correo,
  telefono: usuario.telefono,
  tipoDocumento: usuario.tipoDocumento,
  numeroDocumento: usuario.numeroDocumento,
  esSuperAdmin: usuario.esSuperAdmin,
  imagen: usuario.imagen,
};
---

<LayoutApp title="FlotaX — Perfil" activeTab="profile" navVariant="client">
  <div class="mx-auto w-full max-w-md sm:max-w-xl px-4 py-3 pb-24">
    {/* Componente Integral de Perfil con Fidelidad Visual Apple (Referencia After) */}
    <PerfilEditorCard
      client:load
      usuario={perfilData}
      membresias={membresias}
      localActivoNombre={usuario.localActivo?.nombre}
      estadoVerificacion={estadoVerificacion}
    />
  </div>
</LayoutApp>
