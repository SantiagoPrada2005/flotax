---
import LayoutApp from '@/layouts/LayoutApp.astro';
import PortalSwitchCard from '@/components/perfil/PortalSwitchCard';
import { env } from 'cloudflare:workers';
import { getDb } from '@/lib/db';
import { obtenerLocalesMembresia, type MembresiaLocalResumen } from '@/lib/auth/session';

const usuario = Astro.locals.usuario;
let membresias: MembresiaLocalResumen[] = [];

if (usuario && env.DB) {
  const db = getDb(env.DB);
  membresias = await obtenerLocalesMembresia(db, usuario.id);
}
---

<LayoutApp title="FlotaX — Mi Perfil" activeTab="profile" navVariant="client">
  <div class="mx-auto w-full max-w-md sm:max-w-xl px-4 py-3 space-y-4">
    <header class="pt-1 pb-1">
      <p class="text-xs font-semibold uppercase tracking-wider text-[#4B5563]">
        Cuenta de Cliente
      </p>
      <h1 class="font-display text-2xl font-black tracking-tight text-[#111827] sm:text-3xl">
        Mi Perfil
      </h1>
    </header>

    <div class="rounded-[28px] bg-white p-6 border border-[#9CA3AF]/30 shadow-md">
      <div class="flex items-center gap-3 pb-4 border-b border-[#9CA3AF]/20">
        <div class="flex h-14 w-14 items-center justify-center rounded-full bg-[#111827] text-white font-bold text-lg">
          {usuario?.nombre ? usuario.nombre.substring(0, 2).toUpperCase() : 'FX'}
        </div>
        <div>
          <h2 class="font-display text-base font-bold text-[#111827]">
            {usuario?.nombre ?? 'Cliente FlotaX'}
          </h2>
          <p class="text-xs text-[#4B5563]">{usuario?.correo ?? 'Sin correo registrado'}</p>
        </div>
      </div>

      <div class="mt-4 space-y-3">
        <div class="flex items-center justify-between py-2 text-xs border-b border-[#9CA3AF]/10">
          <span class="text-[#4B5563]">Documento</span>
          <span class="font-mono font-medium text-[#111827]">
            {usuario?.numeroDocumento ?? 'No registrado'}
          </span>
        </div>
        <div class="flex items-center justify-between py-2 text-xs border-b border-[#9CA3AF]/10">
          <span class="text-[#4B5563]">Teléfono</span>
          <span class="font-mono font-medium text-[#111827]">
            {usuario?.telefono ?? 'No registrado'}
          </span>
        </div>
        <div class="flex items-center justify-between py-2 text-xs">
          <span class="text-[#4B5563]">Estado de Licencia</span>
          <span class="inline-flex items-center gap-1 rounded-full bg-amber-50 px-2 py-0.5 text-[10px] font-bold text-amber-700">
            Pendiente de verificación
          </span>
        </div>
      </div>
    </div>

    {usuario && (
      <PortalSwitchCard
        client:load
        membresias={membresias}
        esSuperAdmin={usuario.esSuperAdmin}
        localActivoNombre={usuario.localActivo?.nombre}
      />
    )}
  </div>
</LayoutApp>
