---
import LayoutApp from '@/layouts/LayoutApp.astro';
import { obtenerVehiculoPorId } from '@/lib/flota/mock-vehiculos';

const { id } = Astro.params;
const vehiculo = id ? obtenerVehiculoPorId(id) : undefined;

if (!vehiculo) {
  return Astro.redirect('/catalogo');
}

const formatCop = (val: number) =>
  new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP', maximumFractionDigits: 0 }).format(val);
---

<LayoutApp
  title={`${vehiculo.marca} ${vehiculo.modelo} — Car Detail`}
  showBack={true}
  backHref="/catalogo"
  activeTab="home"
  navVariant="client"
>
  <div class="mx-auto w-full max-w-md sm:max-w-xl px-4 py-2 space-y-5 pb-24">
    {/* 1. Header: Back + Car Detail + Favorite (Screen 3) */}
    <header class="flex items-center justify-between pt-1">
      <a
        href="/catalogo"
        aria-label="Volver al catálogo"
        class="ios-press-bounce flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-white border border-[#E4E4E7] text-[#18181B] shadow-xs cursor-pointer"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" class="h-5 w-5">
          <path d="m15 18-6-6 6-6" />
        </svg>
      </a>

      <h1 class="font-display text-lg font-bold text-[#18181B] tracking-tight">
        Car Detail
      </h1>

      <button
        type="button"
        aria-label="Guardar en favoritos"
        class="ios-press-bounce flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-white border border-[#E4E4E7] text-[#18181B] shadow-xs hover:text-rose-600 transition cursor-pointer"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5">
          <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z" />
        </svg>
      </button>
    </header>

    {/* 2. Visual Central: Gran Foto de Estudio con Sombra de Suelo */}
    <div class="flex flex-col items-center justify-center py-2 relative">
      <img
        src={vehiculo.imagenUrl}
        alt={`${vehiculo.marca} ${vehiculo.modelo}`}
        class="w-full max-h-56 sm:max-h-64 object-contain mx-auto"
      />
      <div class="h-4 w-4/5 mx-auto -mt-3 rounded-full bg-[radial-gradient(ellipse_at_center,_rgba(24,24,27,0.22)_0%,_transparent_75%)]" />

      <div class="text-center mt-3">
        <h2 class="font-display text-xl font-bold text-[#18181B]">
          {vehiculo.marca} {vehiculo.modelo}
        </h2>
        <p class="text-xs text-[#71717A] max-w-sm mt-1 leading-relaxed">
          {vehiculo.descripcion}
        </p>
      </div>
    </div>

    {/* 3. 4 Bento Cards Cuadradas (Screen 3) */}
    <div class="grid grid-cols-2 gap-3">
      {/* Bento 1: Top Speed */}
      <div class="rounded-[24px] bg-[#F4F4F5] p-4 flex flex-col items-center justify-center text-center">
        <div class="flex h-10 w-10 items-center justify-center rounded-full bg-white text-[#18181B] shadow-xs mb-2">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5">
            <path d="m12 14 4-4" />
            <path d="M3.34 19a10 10 0 1 1 17.32 0" />
          </svg>
        </div>
        <span class="text-[10px] font-medium text-[#71717A] lowercase">top speed</span>
        <p class="mt-0.5 font-display text-sm font-bold text-[#18181B]">{vehiculo.velocidadMaxima}</p>
      </div>

      {/* Bento 2: Range (EPA est) */}
      <div class="rounded-[24px] bg-[#F4F4F5] p-4 flex flex-col items-center justify-center text-center">
        <div class="flex h-10 w-10 items-center justify-center rounded-full bg-white text-[#18181B] shadow-xs mb-2">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5">
            <line x1="12" y1="2" x2="12" y2="22" />
            <path d="m17 5-5-3-5 3" />
            <path d="m17 19-5 3-5-3" />
          </svg>
        </div>
        <span class="text-[10px] font-medium text-[#71717A] lowercase">range (EPA est)</span>
        <p class="mt-0.5 font-display text-sm font-bold text-[#18181B]">{vehiculo.autonomiaOdo}</p>
      </div>

      {/* Bento 3: Battery / Propulsión */}
      <div class="rounded-[24px] bg-[#F4F4F5] p-4 flex flex-col items-center justify-center text-center">
        <div class="flex h-10 w-10 items-center justify-center rounded-full bg-white text-[#18181B] shadow-xs mb-2">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5">
            <rect width="16" height="10" x="2" y="7" rx="2" ry="2" />
            <line x1="22" y1="11" x2="22" y2="13" />
          </svg>
        </div>
        <span class="text-[10px] font-medium text-[#71717A] lowercase">propulsión</span>
        <p class="mt-0.5 font-display text-sm font-bold text-[#18181B]">{vehiculo.combustible}</p>
      </div>

      {/* Bento 4: Weather / Clima */}
      <div class="rounded-[24px] bg-[#F4F4F5] p-4 flex flex-col items-center justify-center text-center">
        <div class="flex h-10 w-10 items-center justify-center rounded-full bg-white text-[#18181B] shadow-xs mb-2">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5">
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
            <circle cx="12" cy="12" r="4" />
          </svg>
        </div>
        <span class="text-[10px] font-medium text-[#71717A] lowercase">clima / confort</span>
        <p class="mt-0.5 font-display text-sm font-bold text-[#18181B]">22°C A/C</p>
      </div>
    </div>

    {/* 4. Barra Inferior de Reserva Fija Estilo Screen 3 */}
    <div class="rounded-[28px] bg-white border border-[#E4E4E7] p-4.5 shadow-lg flex items-center justify-between">
      <div>
        <p class="font-display text-xl font-black text-[#18181B]">
          {formatCop(vehiculo.precioDia)}
        </p>
        <span class="text-[11px] text-[#71717A]">Tarifa por día</span>
      </div>

      <a
        href={`/reservas?vehiculoId=${vehiculo.id}`}
        class="ios-press-bounce rounded-full bg-[#18181B] text-white px-7 py-3.5 text-xs font-bold shadow-md hover:bg-black transition active:scale-95"
      >
        Book Rent
      </a>
    </div>
  </div>
</LayoutApp>
