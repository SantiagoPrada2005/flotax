---
import LayoutApp from "@/layouts/LayoutApp.astro";
import VehicleStudioShowcase from "@/components/flota/VehicleStudioShowcase";
import {
  obtenerVehiculoAsync,
  listarVehiculos,
  obtenerLocalPorSlugOId,
  obtenerLocalCatalogoPorDefecto,
} from "@/lib/flota";
import { resolveClientTimeContext } from "@/lib/time/client-time";
import { buildVehicleProductSchema, buildBreadcrumbSchema } from "@/lib/seo";
import { env } from "cloudflare:workers";
import { getDb } from "@/lib/db";

const { id } = Astro.params;
const db = env.DB ? getDb(env.DB) : undefined;
const localCautivo = Astro.locals.localCaptacion;
const modoOperador = Astro.locals.modoPortal === "ADMIN";
const { dateString: hoyISO } = resolveClientTimeContext(Astro.request);

// Validar que el vehículo exista y pertenezca al perímetro del local cautivo
const vehiculo = id
  ? await obtenerVehiculoAsync(id, db, localCautivo?.id, hoyISO)
  : undefined;

if (!vehiculo) {
  return Astro.redirect(
    modoOperador
      ? "/admin/flota"
      : localCautivo
        ? `/c/${localCautivo.slug}`
        : "/catalogo"
  );
}

const local =
  localCautivo ??
  (vehiculo.localId
    ? await obtenerLocalPorSlugOId(vehiculo.localId, db)
    : null) ??
  (await obtenerLocalCatalogoPorDefecto(db));

const flotaLocal = await listarVehiculos(db, { localId: local.id, hoyISO });
const backHref = modoOperador
  ? "/admin/flota"
  : localCautivo
    ? `/c/${local.slug}`
    : "/catalogo";

const siteUrl = (Astro.site ? Astro.site.toString() : 'https://flotax.innovaweb.pro').replace(/\/$/, '');
const vehicleSchema = buildVehicleProductSchema(vehiculo, siteUrl);
const breadcrumbSchema = buildBreadcrumbSchema(
  [
    { name: 'Inicio', path: '/' },
    { name: 'Catálogo', path: '/catalogo' },
    { name: `${vehiculo.marca} ${vehiculo.modelo}`, path: `/vehiculos/${vehiculo.id}` },
  ],
  siteUrl
);

const seoTitle = `Alquiler de ${vehiculo.marca} ${vehiculo.modelo} (${vehiculo.anio}) — ${local.nombre} | FlotaX`;
const seoDescription = `Alquila ${vehiculo.marca} ${vehiculo.modelo} (${vehiculo.categoriaEtiqueta}) desde $${vehiculo.precioDia.toLocaleString('es-CO')}/día en ${local.nombre}. Transmisión ${vehiculo.transmision}, ${vehiculo.combustible}. Entrega en 3 minutos.`;
const canonicalUrl = `${siteUrl}/vehiculos/${vehiculo.id}`;
---

<LayoutApp
  title={seoTitle}
  description={seoDescription}
  canonicalUrl={canonicalUrl}
  ogImage={vehiculo.imagenUrl}
  ogType="product"
  structuredData={[vehicleSchema, breadcrumbSchema]}
  showBack={true}
  backHref={backHref}
  activeTab={modoOperador ? "fleet" : "home"}
  navVariant={modoOperador ? "admin" : "client"}
>
  <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 py-2 pb-28">
    <VehicleStudioShowcase
      client:load
      vehiculoInicial={vehiculo}
      flotaLocal={flotaLocal}
      local={local}
      hoyISO={hoyISO}
    />
  </div>
</LayoutApp>
