---
import LayoutApp from '@/layouts/LayoutApp.astro';
import VehicleStudioShowcase from '@/components/flota/VehicleStudioShowcase';
import {
  obtenerVehiculoAsync,
  listarVehiculos,
  obtenerLocalPorSlugOId,
  obtenerLocalCatalogoPorDefecto,
} from '@/lib/flota';
import { resolveClientTimeContext } from '@/lib/time/client-time';
import { env } from 'cloudflare:workers';
import { getDb } from '@/lib/db';

const { id } = Astro.params;
const db = env.DB ? getDb(env.DB) : undefined;
const localCautivo = Astro.locals.localCaptacion;

// Validar que el vehículo exista y pertenezca al perímetro del local cautivo
const vehiculo = id
  ? await obtenerVehiculoAsync(id, db, localCautivo?.id)
  : undefined;

if (!vehiculo) {
  return Astro.redirect(localCautivo ? `/c/${localCautivo.slug}` : '/catalogo');
}

const local =
  localCautivo ??
  (vehiculo.localId
    ? await obtenerLocalPorSlugOId(vehiculo.localId, db)
    : null) ??
  (await obtenerLocalCatalogoPorDefecto(db));

const flotaLocal = await listarVehiculos(db, { localId: local.id });
const { dateString: hoyISO } = resolveClientTimeContext(Astro.request);
const backHref = localCautivo ? `/c/${local.slug}` : '/catalogo';
---

<LayoutApp
  title={`${vehiculo.marca} ${vehiculo.modelo} — ${local.nombre}`}
  showBack={true}
  backHref={backHref}
  activeTab="home"
  navVariant="client"
>
  <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 py-2 pb-28">
    <VehicleStudioShowcase
      client:load
      vehiculoInicial={vehiculo}
      flotaLocal={flotaLocal}
      local={local}
      backHref={backHref}
      hoyISO={hoyISO}
    />
  </div>
</LayoutApp>
