---
const usuario = Astro.locals.usuario;

if (!usuario) {
  return Astro.redirect('/login');
}

// Redirección inteligente por rol: Personal de patio a /admin, clientes a /catalogo
const esPersonal = usuario.esSuperAdmin || (usuario.localActivo && usuario.localActivo.rol !== 'USUARIO');

if (esPersonal) {
  return Astro.redirect('/admin');
}

return Astro.redirect('/catalogo');
---
