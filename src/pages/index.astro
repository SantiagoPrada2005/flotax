---
import LayoutApp from '../layouts/LayoutApp.astro';
import LandingHeader from '../components/landing/LandingHeader.astro';
import LandingHero from '../components/landing/LandingHero.astro';
import LandingFleetShowcase from '../components/landing/LandingFleetShowcase.astro';
import LandingSteps from '../components/landing/LandingSteps.astro';
import LandingRequirements from '../components/landing/LandingRequirements.astro';
import LandingPriceBreakdown from '../components/landing/LandingPriceBreakdown.astro';
import LandingFinalCta from '../components/landing/LandingFinalCta.astro';
import LandingFooter from '../components/landing/LandingFooter.astro';

const user = Astro.locals.user;
const usuario = Astro.locals.usuario;
---

<LayoutApp
  title="FlotaX — Alquiler de Vehículos en Tiempo Real | Autos, SUVs y Motos"
  description="Alquila vehículos en tiempo real con entrega en 3 minutos. Catálogo de autos sedán, SUVs familiares, motos y patinetas eléctricas sin trámites ni papeleo."
  canonicalUrl="https://flotax.innovaweb.pro/"
  ogImage="/images/landing/hero-vehicle.webp"
  ogType="website"
  hideNav={true}
>
  <div class="relative z-10 bg-[#F5F5F5] flex flex-col w-full antialiased selection:bg-[#2E4E8F] selection:text-white">
    <LandingHeader user={user} usuario={usuario} />

    <main class="flex-1 flex flex-col w-full -mt-14 sm:-mt-16 md:-mt-18">
      <LandingHero />
      <LandingFleetShowcase />
      <LandingSteps />
      <LandingRequirements />
      <LandingPriceBreakdown />
      <LandingFinalCta />
    </main>
  </div>

  <!-- Footer con revelación parallax estilo Erthos (sticky bottom-0 z-0, blanco puro sin sombras ni separaciones) -->
  <LandingFooter user={user} />

  <!-- Scroll Reveal Observer for Entrance Animations with ClientRouter Support -->
  <script>
    const setupScrollReveal = () => {
      document.documentElement.classList.add('js-ready');
      const targets = document.querySelectorAll('.reveal-on-scroll:not(.is-visible)');
      if (!targets.length) return;

      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          {
            threshold: 0.1,
            rootMargin: '0px 0px -40px 0px'
          }
        );

        targets.forEach((target) => observer.observe(target));
      } else {
        targets.forEach((target) => target.classList.add('is-visible'));
      }
    };

    // Re-bind seamlessly across ClientRouter View Transitions
    document.addEventListener('astro:page-load', setupScrollReveal);
  </script>
</LayoutApp>
