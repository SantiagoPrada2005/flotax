---
import LayoutAdmin from '../layouts/LayoutAdmin.astro';
import { resolveClientTimeContext } from '../lib/time/client-time';

const timeContext = resolveClientTimeContext(Astro.request);
---

<LayoutAdmin title="Movix — Panel de Control">
  <main class="mx-auto flex w-full max-w-5xl flex-1 flex-col justify-center px-4 py-12 sm:px-6 lg:px-8">
    <div class="rounded-card border border-border-subtle bg-surface-card p-6 shadow-sm sm:p-10">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <span class="inline-flex items-center gap-1.5 rounded-full bg-surface-canvas px-3 py-1 font-mono text-xs font-semibold uppercase tracking-wider text-brand-accent">
            Movix v0.0.1
          </span>
          <h1 class="mt-3 font-display text-2xl font-bold tracking-tight text-brand-primary sm:text-3xl">
            Sistema de Alquiler de Vehículos
          </h1>
          <p class="mt-2 text-sm text-neutral-600 sm:text-base">
            Monolito Serverless perimetral en Cloudflare Pages, Astro 7, React 19 y Tailwind CSS v4.
          </p>
        </div>
        <div class="rounded-input border border-border-subtle bg-surface-elevated p-3 text-right">
          <p class="text-xs uppercase tracking-wider text-neutral-500">Zona Horaria Operativa</p>
          <p class="font-mono text-sm font-semibold text-brand-primary">{timeContext.timezone}</p>
          <p class="text-xs text-neutral-500">{timeContext.dateString}</p>
        </div>
      </div>

      <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-3">
        <div class="rounded-input border border-border-subtle bg-surface-elevated p-4">
          <p class="text-xs font-medium uppercase tracking-wider text-neutral-500">Flota Activa</p>
          <p class="mt-1 font-display text-2xl font-bold text-brand-primary">0 unidades</p>
          <p class="mt-1 text-xs text-status-success">Autos, motos y patinetas</p>
        </div>
        <div class="rounded-input border border-border-subtle bg-surface-elevated p-4">
          <p class="text-xs font-medium uppercase tracking-wider text-neutral-500">Contratos Activos</p>
          <p class="mt-1 font-display text-2xl font-bold text-brand-primary">0 en curso</p>
          <p class="mt-1 text-xs text-neutral-500">Tarifas y extensiones</p>
        </div>
        <div class="rounded-input border border-border-subtle bg-surface-elevated p-4">
          <p class="text-xs font-medium uppercase tracking-wider text-neutral-500">Inspecciones Periciales</p>
          <p class="mt-1 font-display text-2xl font-bold text-brand-primary">0 registros</p>
          <p class="mt-1 text-xs text-brand-accent">Soporte multimedia R2</p>
        </div>
      </div>

      <div class="mt-8 flex flex-wrap items-center gap-3 border-t border-border-subtle pt-6">
        <button
          type="button"
          class="inline-flex min-h-[44px] min-w-[44px] items-center justify-center rounded-input bg-brand-primary px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-neutral-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-accent"
        >
          Iniciar Operación
        </button>
        <span class="text-xs text-neutral-500">
          Entorno verificado: 0 errores, 0 advertencias.
        </span>
      </div>
    </div>
  </main>
</LayoutAdmin>
