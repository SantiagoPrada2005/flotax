---
import LayoutApp from '../layouts/LayoutApp.astro';
import LandingHeader from '../components/landing/LandingHeader.astro';
import LandingHero from '../components/landing/LandingHero.astro';
import LandingBookingCard from '../components/landing/LandingBookingCard.astro';
import LandingCategories from '../components/landing/LandingCategories.astro';
import LandingFeatured from '../components/landing/LandingFeatured.astro';
import LandingSteps from '../components/landing/LandingSteps.astro';
import LandingTrust from '../components/landing/LandingTrust.astro';
import LandingRequirements from '../components/landing/LandingRequirements.astro';
import LandingPriceBreakdown from '../components/landing/LandingPriceBreakdown.astro';
import LandingFaq from '../components/landing/LandingFaq.astro';
import LandingFinalCta from '../components/landing/LandingFinalCta.astro';
import LandingFooter from '../components/landing/LandingFooter.astro';

const user = Astro.locals.user;
const usuario = Astro.locals.usuario;
---

<LayoutApp title="FlotaX — Alquiler de Vehículos en Tiempo Real" hideNav={true}>
  <div class="min-h-screen bg-white flex flex-col w-full antialiased selection:bg-[#2E4E8F] selection:text-white relative">
    <LandingHeader user={user} usuario={usuario} />

    <main class="flex-1 flex flex-col w-full">
      <LandingHero />
      <LandingBookingCard />
      <LandingCategories />
      <LandingFeatured />
      <LandingSteps />
      <LandingTrust />
      <LandingRequirements />
      <LandingPriceBreakdown />
      <LandingFaq />
      <LandingFinalCta />
    </main>

    <LandingFooter user={user} />
  </div>

  <!-- Scroll Reveal Observer for Entrance Animations -->
  <script>
    const setupScrollReveal = () => {
      const targets = document.querySelectorAll('.reveal-on-scroll');
      if (!targets.length) return;

      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          {
            threshold: 0.1,
            rootMargin: '0px 0px -40px 0px'
          }
        );

        targets.forEach((target) => observer.observe(target));
      } else {
        targets.forEach((target) => target.classList.add('is-visible'));
      }
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupScrollReveal);
    } else {
      setupScrollReveal();
    }
  </script>
</LayoutApp>
