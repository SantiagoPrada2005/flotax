---
import LayoutApp from '@/layouts/LayoutApp.astro';
import VehiculoEntregaWizard from '@/components/reservas/VehiculoEntregaWizard';
import { obtenerReservaClientePorCodigo } from '@/lib/flota';
import { obtenerReservaPorCodigoD1 } from '@/lib/flota/repositorio-reservas';
import { resolveClientTimeContext } from '@/lib/time/client-time';
import { env } from 'cloudflare:workers';
import { getDb } from '@/lib/db';
import { sanitizarRetornoEntrega } from '@/lib/auth/portal-modo';
import { validarAccesoReservaLectura } from '@/lib/auth';

const { codigo } = Astro.params;
const modoOperador = Astro.locals.modoPortal === 'ADMIN';

if (!codigo) {
  return Astro.redirect(modoOperador ? '/admin/reservas' : '/reservas');
}

const tokenQuery = Astro.url.searchParams.get('token');
const usuario = Astro.locals.usuario;
const { dateString: hoyISO } = resolveClientTimeContext(Astro.request);
const db = env.DB ? getDb(env.DB) : undefined;
let reservaInicial = await obtenerReservaPorCodigoD1(db, codigo);
if (!reservaInicial) {
  reservaInicial = obtenerReservaClientePorCodigo(codigo, null, hoyISO) ?? null;
}

if (!reservaInicial) {
  return Astro.redirect(modoOperador ? '/admin/reservas' : '/reservas');
}

const tieneAcceso = validarAccesoReservaLectura(reservaInicial, usuario, tokenQuery);
if (!tieneAcceso) {
  if (!usuario) {
    const returnTo = encodeURIComponent(Astro.url.pathname + Astro.url.search);
    return Astro.redirect(`/login?redirect=${returnTo}`);
  }
  return new Response('Acceso no autorizado a esta reserva.', { status: 403 });
}

const tokenPublicoValido =
  tokenQuery && tokenQuery.trim() === reservaInicial.tokenAccesoPublico
    ? tokenQuery.trim()
    : usuario?.id === reservaInicial.clienteId
      ? reservaInicial.tokenAccesoPublico ?? null
      : null;

const retornoParam = Astro.url.searchParams.get('retorno');
const retornoValido = sanitizarRetornoEntrega(retornoParam);
const retornoHref =
  retornoValido ??
  (modoOperador
    ? `/admin/reservas/${codigo.toUpperCase()}`
    : `/reservas/${codigo.toUpperCase()}${tokenPublicoValido ? `?token=${tokenPublicoValido}` : ''}`);
---

<LayoutApp
  title={`Entrega y Evaluación #${codigo.toUpperCase()} — FlotaX`}
  hideNav={true}
  navVariant={modoOperador ? 'admin' : 'client'}
>
  <VehiculoEntregaWizard
    client:load
    codigo={codigo.toUpperCase()}
    reservaInicial={reservaInicial}
    hoyISO={hoyISO}
    retornoHref={retornoHref}
    tokenAccesoPublico={tokenPublicoValido}
  />
</LayoutApp>
