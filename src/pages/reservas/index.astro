---
import LayoutApp from '@/layouts/LayoutApp.astro';
---

<LayoutApp title="FlotaX — Mis Reservas" activeTab="search" navVariant="client">
  <div class="mx-auto w-full max-w-md sm:max-w-xl px-4 py-3 space-y-4">
    <header class="pt-1 pb-1">
      <p class="text-xs font-semibold uppercase tracking-wider text-[#4B5563]">
        Historial y Alquileres
      </p>
      <div class="mt-0.5 flex items-baseline justify-between">
        <h1 class="font-display text-2xl font-black tracking-tight text-[#111827] sm:text-3xl">
          Mis Reservas
        </h1>
        <a
          href="/catalogo"
          class="inline-flex min-h-[40px] items-center gap-1.5 rounded-full bg-[#111827] px-3.5 py-1.5 text-xs font-semibold text-white shadow-sm transition hover:bg-[#1F2937] active:scale-95"
        >
          Alquilar
        </a>
      </div>
    </header>

    <div class="rounded-[28px] bg-white p-6 border border-[#9CA3AF]/30 shadow-md text-center py-10">
      <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-[#EDEDED] text-[#4B5563]">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-6 w-6">
          <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
          <line x1="16" y1="2" x2="16" y2="6"></line>
          <line x1="8" y1="2" x2="8" y2="6"></line>
          <line x1="3" y1="10" x2="21" y2="10"></line>
        </svg>
      </div>
      <p class="mt-3 text-sm font-semibold text-[#111827]">Sin reservas activas</p>
      <p class="mt-1 text-xs text-[#4B5563]">
        Tus alquileres en curso y pasados se mostrarán aquí con comprobantes e inspecciones periciales.
      </p>
      <div class="mt-5">
        <a
          href="/catalogo"
          class="inline-flex min-h-[44px] items-center justify-center rounded-full bg-[#111827] px-5 py-2 text-xs font-semibold text-white transition hover:bg-[#1F2937]"
        >
          Explorar Vehículos Disponibles
        </a>
      </div>
    </div>
  </div>
</LayoutApp>
