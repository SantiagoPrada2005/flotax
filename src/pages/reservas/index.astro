---
import LayoutApp from '@/layouts/LayoutApp.astro';
import MisReservasHub from '@/components/reservas/MisReservasHub';
import { resolveClientTimeContext } from '@/lib/time/client-time';

const { dateString: hoyISO } = resolveClientTimeContext(Astro.request);
---

<LayoutApp title="FlotaX — Mis Reservas" activeTab="search" navVariant="client">
  <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8 py-2 sm:py-4">
    <MisReservasHub client:load hoyISO={hoyISO} />
  </div>
</LayoutApp>
