---
import '../styles/tokens.css';
import { ClientRouter } from 'astro:transitions';
import TopBar from '../components/navigation/TopBar.astro';
import Sidebar from '../components/navigation/Sidebar.astro';
import BottomNav from '../components/navigation/BottomNav.astro';
import PwaRuntimeIsland from '../components/navigation/PwaRuntimeIsland';
import PwaBootSplash from '../components/navigation/PwaBootSplash.astro';
import SeoHead from '../components/seo/SeoHead.astro';

interface Props {
  title?: string | undefined;
  description?: string | undefined;
  canonicalUrl?: string | undefined;
  ogImage?: string | undefined;
  ogType?: 'website' | 'article' | 'product' | undefined;
  noindex?: boolean | undefined;
  structuredData?: Record<string, unknown> | Array<Record<string, unknown>> | undefined;
  activeTab?: 'home' | 'metrics' | 'search' | 'fleet' | 'wallet' | 'profile' | undefined;
  showBack?: boolean | undefined;
  backHref?: string | undefined;
  hideNav?: boolean | undefined;
  hideBottomNav?: boolean | undefined;
  navVariant?: 'admin' | 'client' | undefined;
}

const {
  title = 'FlotaX — Gestión de Flota y Alquiler',
  description,
  canonicalUrl,
  ogImage,
  ogType,
  noindex,
  structuredData,
  activeTab,
  showBack = false,
  backHref = '/catalogo',
  hideNav = false,
  hideBottomNav = false,
  navVariant = 'client',
} = Astro.props;

const isAdmin = navVariant === 'admin';
const isPrivateArea =
  isAdmin ||
  Astro.url.pathname.startsWith('/admin') ||
  Astro.url.pathname.startsWith('/reservas') ||
  Astro.url.pathname.startsWith('/perfil') ||
  Astro.url.pathname.startsWith('/configuracion') ||
  Astro.url.pathname.startsWith('/notificaciones') ||
  Astro.url.pathname === '/login' ||
  Astro.url.pathname === '/registro' ||
  Astro.url.pathname === '/offline' ||
  Astro.url.pathname === '/error';

const resolvedNoIndex = noindex !== undefined ? noindex : isPrivateArea;

// Inicialización de idioma y tema persistidos en cookies para renderizado SSR
const cookieLang = Astro.cookies.get('flotax_lang')?.value;
const idiomaInicial = cookieLang === 'en' ? 'en' : 'es';
const cookieTheme = Astro.cookies.get('flotax_theme')?.value;
const prefersDarkHeader = Astro.request.headers.get('sec-ch-prefers-color-scheme') === 'dark';
const esOscuroInicial = cookieTheme === 'oscuro' || (cookieTheme !== 'claro' && prefersDarkHeader);
Astro.response.headers.set('Accept-CH', 'Sec-CH-Prefers-Color-Scheme');
---

<!doctype html>
<html
  lang={idiomaInicial}
  class:list={[
    "h-full bg-surface-canvas text-brand-primary antialiased",
    esOscuroInicial ? "dark" : ""
  ]}
  data-theme={esOscuroInicial ? "dark" : "light"}
  style={esOscuroInicial ? "background-color: #111827; color-scheme: dark;" : "background-color: #ededed; color-scheme: light;"}
  data-autenticado={Astro.locals.usuario ? 'true' : 'false'}
>
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, interactive-widget=resizes-content, viewport-fit=cover"
    />
    <meta name="theme-color" content={esOscuroInicial ? "#111827" : "#EDEDED"} />
    <!-- Anti-FOUC Blocking Script (Ejecución síncrona en el primer byte antes de cualquier pintura) -->
    <script is:inline>
      (function() {
        try {
          var t = localStorage.getItem('flotax_theme') || 'sistema';
          var d = t === 'oscuro' || (t === 'sistema' && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches);
          var html = document.documentElement;
          if (d) {
            html.classList.add('dark');
            html.setAttribute('data-theme', 'dark');
            html.style.backgroundColor = '#111827';
            html.style.colorScheme = 'dark';
          } else {
            html.classList.remove('dark');
            html.setAttribute('data-theme', 'light');
            html.style.backgroundColor = '#ededed';
            html.style.colorScheme = 'light';
          }
          var metaTc = document.querySelector('meta[name="theme-color"]');
          if (metaTc) metaTc.setAttribute('content', d ? '#111827' : '#EDEDED');
          var l = localStorage.getItem('flotax_lang');
          if (l === 'en' || l === 'es') html.lang = l;
        } catch (e) {}
      })();
    </script>
    <meta name="application-name" content="FlotaX" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="FlotaX" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <!-- Tipografías críticas locales precargadas -->
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/space-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin />
    <SeoHead
      title={title}
      description={description}
      canonicalUrl={canonicalUrl}
      ogImage={ogImage}
      ogType={ogType}
      noindex={resolvedNoIndex}
      structuredData={structuredData}
    />
    <ClientRouter />

    <!-- Sincronizador de tema e idioma durante transiciones SPA -->
    <script>
      const sincronizarTema = () => {
        try {
          const tema = localStorage.getItem('flotax_theme') || 'sistema';
          const oscuro = tema === 'oscuro' || (tema === 'sistema' && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches);
          const html = document.documentElement;
          html.classList.toggle('dark', oscuro);
          html.setAttribute('data-theme', oscuro ? 'dark' : 'light');
          html.style.backgroundColor = oscuro ? '#111827' : '#ededed';
          html.style.colorScheme = oscuro ? 'dark' : 'light';
          const metaTc = document.querySelector('meta[name="theme-color"]');
          if (metaTc) metaTc.setAttribute('content', oscuro ? '#111827' : '#EDEDED');
          const lang = localStorage.getItem('flotax_lang');
          if (lang) html.lang = lang;
        } catch {}
      };
      document.addEventListener('astro:after-swap', sincronizarTema);
      document.addEventListener('astro:page-load', sincronizarTema);
      if (typeof window !== 'undefined' && window.matchMedia) {
        window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
          const tema = localStorage.getItem('flotax_theme') || 'sistema';
          if (tema === 'sistema') {
            sincronizarTema();
          }
        });
      }
    </script>
  </head>
  <body class="flex min-h-full flex-col font-body selection:bg-brand-secondary/20 selection:text-brand-primary">
    <PwaBootSplash />
    <PwaRuntimeIsland client:load transition:persist="flotax-pwa-runtime" />
    <div class="flex min-h-screen w-full flex-row">
      <!-- Desktop Navigation Sidebar (Only for Admin) -->
      {!hideNav && isAdmin && <Sidebar activeTab={activeTab} />}

      <!-- Main Layout Body -->
      <div class="flex flex-1 flex-col min-w-0">
        <!-- Minimalist Top App Bar -->
        {!hideNav && (
          <TopBar
            title={title}
            showBack={showBack}
            backHref={backHref}
            navVariant={navVariant}
            class={isAdmin ? "md:left-64" : ""}
          />
        )}

        <!-- Content Area: padded for minimalist TopBar (pt-14), floating dock on mobile (pb-32) and standard on desktop (pb-8) -->
        <main class:list={[
          "flex-1 w-full",
          !hideNav ? (hideBottomNav ? "pt-14 pb-8" : "pt-14 pb-32 md:pb-8") : ""
        ]}>
          <slot />
        </main>
      </div>
    </div>

    <!-- Mobile Bottom Navigation (Floating Island) -->
    {!hideNav && !hideBottomNav && <BottomNav activeTab={activeTab} variant={navVariant} />}
  </body>
</html>
