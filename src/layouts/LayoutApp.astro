---
import '../styles/tokens.css';
import { ClientRouter } from 'astro:transitions';
import TopBar from '../components/navigation/TopBar.astro';
import Sidebar from '../components/navigation/Sidebar.astro';
import BottomNav from '../components/navigation/BottomNav.astro';

interface Props {
  title?: string | undefined;
  activeTab?: 'home' | 'search' | 'fleet' | 'wallet' | 'profile' | undefined;
  showBack?: boolean | undefined;
  backHref?: string | undefined;
  hideNav?: boolean | undefined;
  navVariant?: 'admin' | 'client' | undefined;
}

const {
  title = 'FlotaX — Gestión de Flota y Alquiler',
  activeTab,
  showBack = false,
  backHref = '/catalogo',
  hideNav = false,
  navVariant = 'client',
} = Astro.props;

const isAdmin = navVariant === 'admin';
---

<!doctype html>
<html lang="es" class="h-full bg-surface-canvas text-brand-primary antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, interactive-widget=resizes-content, viewport-fit=cover"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;600&family=Manrope:wght@500;600;700;800&family=Space+Grotesk:wght@500;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class="flex min-h-full flex-col font-body selection:bg-brand-secondary/20 selection:text-brand-primary">
    <div class="flex min-h-screen w-full flex-row">
      <!-- Desktop Navigation Sidebar (Only for Admin) -->
      {!hideNav && isAdmin && <Sidebar activeTab={activeTab} />}

      <!-- Main Layout Body -->
      <div class="flex flex-1 flex-col min-w-0">
        <!-- Top App Bar (Floating Pills) -->
        {!hideNav && (
          <TopBar
            title={title}
            showBack={showBack}
            backHref={backHref}
            class={isAdmin ? "md:left-64" : ""}
          />
        )}

        <!-- Content Area: padded for floating TopBar (pt-16), floating dock on mobile (pb-32) and standard on desktop (pb-8) -->
        <main class:list={[
          "flex-1 w-full",
          !hideNav ? "pt-16 pb-32 md:pb-8" : ""
        ]}>
          <slot />
        </main>
      </div>
    </div>

    <!-- Mobile Bottom Navigation (Floating Island) -->
    {!hideNav && <BottomNav activeTab={activeTab} variant={navVariant} />}
  </body>
</html>
