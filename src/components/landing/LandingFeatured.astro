---
// src/components/landing/LandingFeatured.astro
interface Vehicle {
  name: string;
  sub: string;
  price: string;
  unit: string;
  category: string;
  users: string;
  trans: string;
  fuel: string;
  image: string;
  isPopular?: boolean;
}

const featuredVehicles: Vehicle[] = [
  {
    name: "Toyota Corolla",
    sub: "Sedán Confort · Automático",
    price: "$1,990",
    unit: "/día",
    category: "Sedán",
    users: "4 pas",
    trans: "Automático",
    fuel: "Gasolina",
    image: "/images/landing/feat-toyota-corolla.jpg",
    isPopular: true
  },
  {
    name: "Honda CB650R",
    sub: "Deportiva Neo Sports · Manual",
    price: "$1,450",
    unit: "/día",
    category: "Moto",
    users: "2 pas",
    trans: "Manual 6v",
    fuel: "Gasolina",
    image: "/images/landing/feat-honda-cb650r.jpg",
    isPopular: true
  },
  {
    name: "Kia Sportage",
    sub: "SUV Familiar · Tracción Inteligente",
    price: "$2,350",
    unit: "/día",
    category: "SUV",
    users: "5 pas",
    trans: "Automático",
    fuel: "Híbrido",
    image: "/images/landing/feat-kia-sportage.jpg",
    isPopular: true
  }
];
---

<section
  id="vehiculos"
  data-pencil-name="FeaturedSection"
  class="w-full py-12 sm:py-16 md:py-20 relative z-10 reveal-on-scroll"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col gap-8 md:gap-12">
    
    <!-- Section Header with Fluid Typography & Clear Subtext -->
    <div class="w-full flex flex-col sm:flex-row sm:items-end justify-between gap-4">
      <div class="flex flex-col gap-2 max-w-xl">
        <span class="inline-flex items-center gap-1.5 text-xs font-mono font-bold tracking-wider uppercase text-[#2E4E8F] bg-[#EEF2F6] px-3 py-1 rounded-full w-fit">
          FLOTA DESTACADA
        </span>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-[#0C1120] font-[Manrope,system-ui,sans-serif] tracking-tight">
          Vehículos listos en patio
        </h2>
        <p class="text-sm sm:text-base text-[#4B5563] leading-relaxed">
          Unidades con mantenimiento riguroso, seguro pericial incluido y entrega inmediata en menos de 3 minutos.
        </p>
      </div>

      <a
        href="/catalogo"
        class="inline-flex items-center gap-2 text-sm font-bold text-[#0C1120] hover:text-[#2E4E8F] transition-colors group"
      >
        <span>Explorar todo el inventario</span>
        <span class="group-hover:translate-x-1 transition-transform">→</span>
      </a>
    </div>

    <!-- Responsive Grid / Mobile Swipe -->
    <div
      class="w-full flex md:grid md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8 overflow-x-auto md:overflow-visible no-scrollbar pb-4 md:pb-0"
    >
      {featuredVehicles.map((v) => (
        <article
          class="min-w-[290px] sm:min-w-[320px] md:min-w-0 bg-white rounded-[26px] overflow-hidden border border-[#E8ECF3] shadow-[0_10px_30px_-8px_rgba(12,17,32,0.06)] hover:shadow-[0_20px_40px_-10px_rgba(12,17,32,0.12)] hover:border-[#2E4E8F]/30 transition-all duration-300 flex flex-col justify-between group"
        >
          <!-- Image Container with Lighting & Badges -->
          <div class="relative w-full aspect-[16/10] bg-gradient-to-b from-[#F8FAFC] to-[#EEF2F6] overflow-hidden flex items-center justify-center p-4">
            <img
              src={v.image}
              alt={v.name}
              class="w-full h-full object-cover rounded-2xl group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />

            <!-- Top Left Status Badge -->
            <div class="absolute top-3 left-3 flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/90 backdrop-blur-md border border-white/80 shadow-xs">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
              <span class="text-[11px] font-bold text-[#0C1120] font-[Manrope,system-ui,sans-serif]">Disponible</span>
            </div>

            <!-- Top Right Category Chip -->
            <div class="absolute top-3 right-3 px-3 py-1 rounded-full bg-[#0C1120]/80 backdrop-blur-md text-white text-[11px] font-semibold">
              {v.category}
            </div>
          </div>

          <!-- Vehicle Details -->
          <div class="p-5 sm:p-6 flex flex-col gap-4">
            <div class="flex items-start justify-between gap-3">
              <div>
                <h3 class="text-lg sm:text-xl font-extrabold text-[#0C1120] font-[Manrope,system-ui,sans-serif] tracking-tight">
                  {v.name}
                </h3>
                <p class="text-xs text-[#9CA3AF] mt-0.5 font-[Inter,system-ui,sans-serif]">
                  {v.sub}
                </p>
              </div>

              <div class="text-right">
                <span class="text-xl sm:text-2xl font-black text-[#0C1120] font-[Manrope,system-ui,sans-serif]">
                  {v.price}
                </span>
                <span class="text-xs text-[#9CA3AF] block font-[Inter,system-ui,sans-serif]">
                  {v.unit}
                </span>
              </div>
            </div>

            <!-- Specifications Chips -->
            <div class="grid grid-cols-3 gap-2 py-3 border-y border-[#F4F6FA] text-center text-xs text-[#4B5563]">
              <div class="flex items-center justify-center gap-1.5 bg-[#F8FAFC] py-1.5 px-2 rounded-xl">
                <span>👤</span>
                <span class="font-semibold truncate">{v.users}</span>
              </div>
              <div class="flex items-center justify-center gap-1.5 bg-[#F8FAFC] py-1.5 px-2 rounded-xl">
                <span>⚙️</span>
                <span class="font-semibold truncate">{v.trans}</span>
              </div>
              <div class="flex items-center justify-center gap-1.5 bg-[#F8FAFC] py-1.5 px-2 rounded-xl">
                <span>⛽</span>
                <span class="font-semibold truncate">{v.fuel}</span>
              </div>
            </div>

            <!-- Booking CTA -->
            <a
              href="/catalogo"
              class="w-full h-11 sm:h-12 flex items-center justify-center gap-2 rounded-xl sm:rounded-2xl bg-[#0C1120] hover:bg-[#1F2937] text-white text-xs sm:text-sm font-bold font-[Manrope,system-ui,sans-serif] shadow-xs active:scale-[0.98] transition-all group"
            >
              <span>Reservar Unidad</span>
              <span class="group-hover:translate-x-1 transition-transform">→</span>
            </a>
          </div>
        </article>
      ))}
    </div>

  </div>
</section>
