---
// src/components/landing/LandingRequirements.astro
// Requisitos de Alquiler: 4 Columnas Abiertas Flotando Directo en Fondo (Sin Contenedor Card, Tipografía Pura)
---

<section
  id="requisitos"
  data-pencil-name="Requirements"
  class="w-full py-6 sm:py-8 md:py-10 relative z-10"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col gap-8 md:gap-10">
    
    <!-- Section Header Centrado y Directo (3 palabras) -->
    <div class="w-full text-center max-w-xl mx-auto">
      <h2 class="text-3xl sm:text-4xl md:text-[40px] font-medium text-[#111827] dark:text-[#EDEDED] tracking-tight leading-tight transition-colors">
        Requisitos de alquiler
      </h2>
    </div>

    <!-- 4 Columnas Abiertas (Sin Card Contenedora Externa) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-7 lg:gap-8">
      
      <!-- Columna 1: Identificación Oficial -->
      <div class="flex flex-col gap-4">
        <!-- Tarjeta Flotante -->
        <div class="w-full aspect-[1.58/1] bg-black rounded-2xl p-4 sm:p-5 shadow-sm border border-white/10 flex flex-col justify-between select-none text-white">
          <div class="flex items-center justify-between">
            <span class="text-xs font-medium text-white/90 tracking-tight">Identity Pass</span>
            <span class="text-[9px] font-mono text-[#9CA3AF] tracking-wider uppercase font-semibold">OFICIAL</span>
          </div>

          <div class="flex items-end justify-between pt-2">
            <div class="flex flex-col">
              <span class="text-[9px] font-mono text-[#9CA3AF]">Documento</span>
              <span class="text-xs font-medium text-white">Cédula / Pasaporte</span>
            </div>
            <span class="text-[10px] font-mono text-white/80 font-bold tracking-widest">ID-1</span>
          </div>
        </div>

        <!-- Texto Directo sobre el Fondo -->
        <div class="flex flex-col gap-1.5">
          <h3 class="text-lg sm:text-xl font-medium text-[#111827] dark:text-[#EDEDED] tracking-tight leading-snug transition-colors">
            Identificación oficial
          </h3>
          <p class="text-xs sm:text-sm text-[#4B5563] dark:text-[#9CA3AF] leading-normal font-normal transition-colors">
            Cédula de ciudadanía o extranjería, o pasaporte vigente para turistas internacionales.
          </p>
        </div>
      </div>

      <!-- Columna 2: Licencia Vigente -->
      <div class="flex flex-col gap-4">
        <!-- Tarjeta Flotante -->
        <div class="w-full aspect-[1.58/1] bg-black rounded-2xl p-4 sm:p-5 shadow-sm border border-white/10 flex flex-col justify-between select-none text-white">
          <div class="flex items-center justify-between">
            <span class="text-xs font-medium text-white/90 tracking-tight">Driver Pass</span>
            <span class="text-[9px] font-mono text-[#9CA3AF] tracking-wider uppercase font-semibold">VIGENTE</span>
          </div>

          <div class="flex items-end justify-between pt-2">
            <div class="flex flex-col">
              <span class="text-[9px] font-mono text-[#9CA3AF]">Categoría</span>
              <span class="text-xs font-medium text-white">Autos &amp; Motos</span>
            </div>
            <span class="text-[10px] font-mono text-white/80 font-bold tracking-widest">A2 • B1</span>
          </div>
        </div>

        <!-- Texto Directo sobre el Fondo -->
        <div class="flex flex-col gap-1.5">
          <h3 class="text-lg sm:text-xl font-medium text-[#111827] dark:text-[#EDEDED] tracking-tight leading-snug transition-colors">
            Licencia vigente
          </h3>
          <p class="text-xs sm:text-sm text-[#4B5563] dark:text-[#9CA3AF] leading-normal font-normal transition-colors">
            Acreditación de conducción física o digital válida para la categoría seleccionada.
          </p>
        </div>
      </div>

      <!-- Columna 3: Mayor de 21 años -->
      <div class="flex flex-col gap-4">
        <!-- Número 21+ Flotante -->
        <div class="w-full aspect-[1.58/1] flex items-center justify-center select-none">
          <div class="flex items-baseline gap-1.5">
            <span class="text-6xl sm:text-7xl font-extrabold text-[#111827] dark:text-white tracking-tighter leading-none transition-colors">
              21+
            </span>
            <span class="text-xs sm:text-sm font-mono font-bold text-[#9CA3AF] tracking-wider uppercase">
              AÑOS
            </span>
          </div>
        </div>

        <!-- Texto Directo sobre el Fondo -->
        <div class="flex flex-col gap-1.5">
          <h3 class="text-lg sm:text-xl font-medium text-[#111827] dark:text-[#EDEDED] tracking-tight leading-snug transition-colors">
            Mayor de 21 años
          </h3>
          <p class="text-xs sm:text-sm text-[#4B5563] dark:text-[#9CA3AF] leading-normal font-normal transition-colors">
            21 años cumplidos para autos y SUVs. Desde 18 años para motocicletas y scooters.
          </p>
        </div>
      </div>

      <!-- Columna 4: Medio de Pago -->
      <div class="flex flex-col gap-4">
        <!-- Tarjeta Flotante Visa -->
        <div class="w-full aspect-[1.58/1] bg-black rounded-2xl p-4 sm:p-5 shadow-sm border border-white/10 flex flex-col justify-between select-none text-white">
          <div class="flex items-center justify-between">
            <span class="text-xs font-medium text-white/90 tracking-tight">Virtual Card</span>
          </div>

          <div class="flex items-end justify-between pt-2">
            <div class="flex flex-col">
              <span class="text-[9px] font-mono text-[#9CA3AF]">Name</span>
              <span class="text-xs font-medium text-white">FlotaX Member</span>
            </div>
            
            <!-- Logo VISA en SVG Blanco Puro -->
            <svg class="h-3.5 w-auto text-white fill-current shrink-0" viewBox="0 0 48 16">
              <path d="M18.8 1.2L14.1 14.8H11L7.1 3.8c-.2-.7-.5-1-1.1-1.3-.9-.5-2.4-1-3.7-1.3l.1-.4h6.5c.8 0 1.5.6 1.7 1.5l1.6 8.7 4-10.8h2.6zm13.1 7.4c0-2.9-4-3.1-4-4.4 0-.5.5-1.1 1.7-1.2.6-.1 2.2-.2 4.1.7l.7-3.4c-1-.4-2.4-.7-4-.7-4.2 0-7.2 2.3-7.2 5.5 0 2.4 2.1 3.7 3.7 4.5 1.7.8 2.2 1.4 2.2 2.1 0 1.1-1.3 1.6-2.6 1.6-2.2 0-3.4-.5-4.4-1l-.8 3.6c1 .5 2.9.9 4.7.9 4.5 0 7.4-2.2 7.4-5.8zm12.9 5.3h2.9l-2.5-12.7h-2.7c-.8 0-1.6.5-1.9 1.3L34.6 14.8h3.1l.6-1.7h3.9l.6 1.7zm-3.3-3.8l2.1-5.8 1.2 5.8h-3.3zM25.7 1.2l-2.4 13.6h-2.9l2.4-13.6h2.9z"/>
            </svg>
          </div>
        </div>

        <!-- Texto Directo sobre el Fondo -->
        <div class="flex flex-col gap-1.5">
          <h3 class="text-lg sm:text-xl font-medium text-[#111827] dark:text-[#EDEDED] tracking-tight leading-snug transition-colors">
            Medio de pago
          </h3>
          <p class="text-xs sm:text-sm text-[#4B5563] dark:text-[#9CA3AF] leading-normal font-normal transition-colors">
            Tarjeta de crédito, débito o transferencia bancaria para tarifa y depósito de garantía.
          </p>
        </div>
      </div>

    </div>

  </div>
</section>
