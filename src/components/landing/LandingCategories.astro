---
// src/components/landing/LandingCategories.astro
const categories = [
  { id: 'economico', name: 'Económico', price: '$1,190', icon: 'tag', desc: 'Eficiente & ágil' },
  { id: 'sedan', name: 'Sedán', price: '$1,490', icon: 'car', desc: 'Confort urbano' },
  { id: 'suv', name: 'SUV', price: '$1,990', icon: 'suv', desc: 'Espacio familiar' },
  { id: 'pickup', name: 'Pickup', price: '$2,490', icon: 'truck', desc: 'Carga & fuerza' },
  { id: 'moto', name: 'Moto Urbana', price: '$890', icon: 'moto', desc: 'Cero tráfico' },
  { id: 'scooter', name: 'Scooter', price: '$690', icon: 'scooter', desc: '100% eléctrico' },
  { id: 'deportiva', name: 'Deportiva', price: '$1,350', icon: 'speed', desc: 'Potencia pura' },
];
---

<section
  id="categorias"
  data-pencil-name="CatSection"
  class="w-full py-12 sm:py-16 md:py-20 relative z-10 reveal-on-scroll"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col gap-8 md:gap-12">
    
    <!-- Section Header with Clear Hierarchy -->
    <div class="w-full flex flex-col sm:flex-row sm:items-end justify-between gap-4">
      <div class="flex flex-col gap-2 max-w-xl">
        <span class="inline-flex items-center gap-1.5 text-xs font-mono font-bold tracking-wider uppercase text-[#2E4E8F] bg-[#EEF2F6] px-3 py-1 rounded-full w-fit">
          CATEGORÍAS DE FLOTA
        </span>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-[#0C1120] font-[Manrope,system-ui,sans-serif] tracking-tight">
          Muévete con total libertad
        </h2>
        <p class="text-sm sm:text-base text-[#4B5563] leading-relaxed">
          Explora unidades seleccionadas por tamaño, propósito o rendimiento para tu próxima ruta.
        </p>
      </div>

      <a
        href="/catalogo"
        class="hidden sm:inline-flex items-center gap-2 text-sm font-bold text-[#0C1120] hover:text-[#2E4E8F] transition-colors group"
      >
        <span>Ver todas las unidades</span>
        <span class="group-hover:translate-x-1 transition-transform">→</span>
      </a>
    </div>

    <!-- Responsive Grid / Mobile Horizontal Swipe -->
    <div
      class="w-full flex md:grid md:grid-cols-4 lg:grid-cols-7 gap-3 sm:gap-4 overflow-x-auto md:overflow-visible no-scrollbar pb-3 md:pb-0"
    >
      {categories.map((cat, idx) => (
        <a
          href={`/catalogo?cat=${cat.id}`}
          class={`group min-w-[130px] sm:min-w-[140px] md:min-w-0 p-4 sm:p-5 rounded-2xl flex flex-col justify-between items-center text-center transition-all duration-300 hover:scale-[1.03] active:scale-[0.98] border ${
            idx === 0
              ? 'bg-[#0C1120] text-white border-[#2E4E8F] shadow-[0_10px_25px_-5px_rgba(46,78,143,0.3)]'
              : 'bg-white hover:bg-[#F8FAFC] text-[#0C1120] border-[#E8ECF3] shadow-xs hover:border-[#2E4E8F]/40 hover:shadow-md'
          }`}
        >
          <!-- Icon Capsule -->
          <div class={`w-12 h-12 rounded-xl flex items-center justify-center mb-3 transition-colors ${
            idx === 0 ? 'bg-white/10 text-[#7FB4FF]' : 'bg-[#F4F6FA] text-[#2E4E8F] group-hover:bg-[#EEF2F6]'
          }`}>
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>

          <!-- Titles & Pricing -->
          <div class="flex flex-col items-center">
            <span class="text-sm font-bold font-[Manrope,system-ui,sans-serif] tracking-tight">
              {cat.name}
            </span>
            <span class={`text-[11px] mt-0.5 ${idx === 0 ? 'text-[#9AA3B2]' : 'text-[#4B5563]'}`}>
              {cat.desc}
            </span>
          </div>

          <div class="mt-4 pt-3 border-t w-full flex flex-col items-center border-inherit/40">
            <span class={`text-xs font-bold ${idx === 0 ? 'text-[#A7C9FF]' : 'text-[#2E4E8F]'}`}>
              {cat.price}<span class="text-[10px] font-normal opacity-75">/d</span>
            </span>
          </div>
        </a>
      ))}
    </div>

  </div>
</section>
