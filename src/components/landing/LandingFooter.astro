---
import FlotaxIsotype from '../ui/FlotaxIsotype.astro';

interface Props {
  user?: {
    id: string;
    name?: string | null;
    email?: string | null;
  } | null;
}

const { user = null } = Astro.props;
---
<footer
  data-pencil-name="Footer"
  class="w-full bg-[#FFFFFF] dark:bg-[#0C1120] sticky bottom-0 z-0 pt-20 sm:pt-28 md:pt-36 pb-28 md:pb-24 border-0 text-[#111827] dark:text-[#EDEDED] transition-colors"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col gap-16 md:gap-24">
    <!-- Desktop Columns / Mobile Brand Layout (Erthos Inspired) -->
    <div class="w-full grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-12">
      <!-- Col 1: Brand & Bio (Logo Negro Puro sin Contenedor) -->
      <div class="md:col-span-5 flex flex-col items-start gap-4 sm:gap-5">
        <div
          data-pencil-name="FBLeft"
          class="flex items-center gap-3.5 select-none text-[#111827] dark:text-white transition-colors"
        >
          <FlotaxIsotype size={44} fill="currentColor" />
          <span
            data-pencil-name="FootName"
            class="text-3xl sm:text-4xl font-extrabold text-[#111827] dark:text-[#EDEDED] font-[Manrope,system-ui,sans-serif] tracking-tight transition-colors"
          >
            FlotaX
          </span>
        </div>

        <p class="text-xs sm:text-sm text-[#1F2937] dark:text-[#D1D5DB] font-normal leading-normal max-w-sm font-[Inter,system-ui,sans-serif] transition-colors">
          Sistema operativo perimetral de alquiler y control de flotas. Entrega ágil en patio, inspección pericial digital y máxima claridad de tarifas.
        </p>

        <div class="flex items-center gap-2.5 text-xs sm:text-sm text-[#111827] dark:text-[#EDEDED] pt-1 transition-colors">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>Red de patios operativa 24/7 en tiempo real</span>
        </div>
      </div>

      <!-- Col 2: Navegación (Tipografía idéntica a Cómo funciona: font-medium text-[#111827]) -->
      <div class="hidden md:flex md:col-span-3 flex-col gap-3.5">
        <h3 class="text-lg sm:text-xl font-medium text-[#111827] dark:text-[#EDEDED] tracking-tight leading-snug transition-colors">
          Navegación
        </h3>
        <ul class="flex flex-col gap-2.5 font-[Inter,system-ui,sans-serif]">
          <li>
            <a href="#vehiculos" class="text-xs sm:text-sm text-[#1F2937] dark:text-[#D1D5DB] hover:text-[#111827] dark:hover:text-white transition-colors leading-normal font-normal">
              Vehículos en patio
            </a>
          </li>
          <li>
            <a href="#proceso" class="text-xs sm:text-sm text-[#1F2937] dark:text-[#D1D5DB] hover:text-[#111827] dark:hover:text-white transition-colors leading-normal font-normal">
              Cómo funciona
            </a>
          </li>
          <li>
            <a href="#requisitos" class="text-xs sm:text-sm text-[#1F2937] dark:text-[#D1D5DB] hover:text-[#111827] dark:hover:text-white transition-colors leading-normal font-normal">
              Requisitos de alquiler
            </a>
          </li>
          <li>
            <a href="#tarifas" class="text-xs sm:text-sm text-[#1F2937] dark:text-[#D1D5DB] hover:text-[#111827] dark:hover:text-white transition-colors leading-normal font-normal">
              Por qué elegirnos
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Servicios & Plataforma -->
      <div class="hidden md:flex md:col-span-2 flex-col gap-3.5">
        <h3 class="text-lg sm:text-xl font-medium text-[#111827] dark:text-[#EDEDED] tracking-tight leading-snug transition-colors">
          Servicios
        </h3>
        <ul class="flex flex-col gap-2.5 font-[Inter,system-ui,sans-serif]">
          <li>
            <a href="/catalogo" class="text-xs sm:text-sm text-[#1F2937] dark:text-[#D1D5DB] hover:text-[#111827] dark:hover:text-white transition-colors leading-normal font-normal">
              Catálogo
            </a>
          </li>
          <li>
            <a href={user ? "/admin/alquileres" : "/login"} class="text-xs sm:text-sm text-[#1F2937] dark:text-[#D1D5DB] hover:text-[#111827] dark:hover:text-white transition-colors leading-normal font-normal">
              Reservas
            </a>
          </li>
          <li>
            <a href={user ? "/admin" : "/login"} class="text-xs sm:text-sm text-[#1F2937] dark:text-[#D1D5DB] hover:text-[#111827] dark:hover:text-white transition-colors leading-normal font-normal">
              Mi cuenta
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 4: Redes & Contacto -->
      <div class="md:col-span-2 flex flex-col gap-3.5">
        <h3 class="text-lg sm:text-xl font-medium text-[#111827] dark:text-[#EDEDED] tracking-tight leading-snug transition-colors">
          Contacto
        </h3>
        <ul class="flex flex-col gap-2.5 font-[Inter,system-ui,sans-serif]">
          <li>
            <a
              href="https://instagram.com"
              target="_blank"
              rel="noopener noreferrer"
              class="text-xs sm:text-sm text-[#1F2937] dark:text-[#D1D5DB] hover:text-[#111827] dark:hover:text-white transition-colors leading-normal font-normal"
            >
              Instagram
            </a>
          </li>
          <li>
            <a
              href="/catalogo"
              class="text-xs sm:text-sm text-[#1F2937] dark:text-[#D1D5DB] hover:text-[#111827] dark:hover:text-white transition-colors leading-normal font-normal"
            >
              Atención en patio
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Row: Copyright & Legal (Negro Puro #111827, Sin Bordes, Espaciado Generoso y Aireado) -->
    <div class="w-full flex flex-col sm:flex-row sm:justify-between sm:items-center gap-4 text-xs sm:text-sm text-[#111827] dark:text-[#9CA3AF]">
      <p data-pencil-name="FootCopy" class="font-normal text-[#111827] dark:text-[#9CA3AF]">
        © 2026 FlotaX Inc. Todos los derechos reservados.
      </p>

      <div class="flex flex-wrap items-center gap-4 sm:gap-6 text-[#111827] dark:text-[#9CA3AF] font-normal">
        <a href="#" class="hover:text-[#4B5563] dark:hover:text-white transition-colors">Aviso de Privacidad</a>
        <a href="#" class="hover:text-[#4B5563] dark:hover:text-white transition-colors">Términos de Servicio</a>
        <a href="#" class="hover:text-[#4B5563] dark:hover:text-white transition-colors">Peritaje R2</a>
      </div>
    </div>
  </div>

  <!-- Floating Mobile Sticky Bottom Navigation (Only visible on small devices) -->
  <nav
    data-pencil-name="BottomNav"
    class="fixed bottom-4 inset-x-0 mx-auto w-[calc(100%-32px)] max-w-[358px] h-[66px] shadow-[0_16px_32px_rgba(46,78,143,0.18)] flex md:hidden flex-row justify-between items-center px-2 bg-white/95 dark:bg-[#1F2937]/95 backdrop-blur-xl border border-[#E8ECF3] dark:border-white/10 rounded-[33px] z-50 transition-all"
    aria-label="Navegación principal inferior"
  >
    <a
      href="/"
      class="h-[50px] flex items-center gap-2 px-4 bg-[#0C1120] dark:bg-white text-white dark:text-[#111827] rounded-full shadow-sm text-xs font-bold transition-colors"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
      </svg>
      <span>Inicio</span>
    </a>

    <a
      href="/catalogo"
      class="h-[50px] flex items-center gap-1.5 px-3 text-[#3E4756] dark:text-[#D1D5DB] hover:text-[#0C1120] dark:hover:text-white text-xs font-semibold transition-colors"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
      </svg>
      <span>Flota</span>
    </a>

    <a
      href={user ? "/admin/alquileres" : "/login"}
      class="h-[50px] flex items-center gap-1.5 px-3 text-[#3E4756] dark:text-[#D1D5DB] hover:text-[#0C1120] dark:hover:text-white text-xs font-semibold transition-colors"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
      </svg>
      <span>Reservas</span>
    </a>

    <a
      href={user ? "/admin" : "/login"}
      class="h-[50px] flex items-center gap-1.5 px-3 text-[#3E4756] dark:text-[#D1D5DB] hover:text-[#0C1120] dark:hover:text-white text-xs font-semibold transition-colors"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
      </svg>
      <span>{user ? "Panel" : "Entrar"}</span>
    </a>
  </nav>
</footer>
