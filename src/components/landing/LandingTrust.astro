---
// src/components/landing/LandingTrust.astro
const trustCards = [
  {
    title: "Documentación clara",
    desc: "Contrato digital transparente sin letras pequeñas ni cláusulas ambiguas.",
    icon: "file-text"
  },
  {
    title: "Inspección pericial R2",
    desc: "Registro fotográfico inmutable 360° antes y después del viaje.",
    icon: "shield-check"
  },
  {
    title: "Precios garantizados",
    desc: "Tarifas fijas con seguro incluido. Sin cobros sorpresivos en patio.",
    icon: "calculator"
  },
  {
    title: "Asistencia vial 24/7",
    desc: "Soporte operativo continuo en carretera ante cualquier eventualidad.",
    icon: "headphones"
  }
];
---

<section
  id="confianza"
  data-pencil-name="TrustSection"
  class="w-full py-12 sm:py-16 md:py-20 relative z-10 reveal-on-scroll bg-[#F8FAFC]/60 border-y border-[#E8ECF3]"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col gap-8 md:gap-12">
    
    <!-- Section Header -->
    <div class="flex flex-col gap-2 max-w-xl">
      <span class="inline-flex items-center gap-1.5 text-xs font-mono font-bold tracking-wider uppercase text-[#2E4E8F] bg-[#EEF2F6] px-3 py-1 rounded-full w-fit">
        SEGURIDAD & CONFIANZA
      </span>
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-[#0C1120] font-[Manrope,system-ui,sans-serif] tracking-tight">
        Todo claro. Desde el primer instante.
      </h2>
      <p class="text-sm sm:text-base text-[#4B5563] leading-relaxed">
        Priorizamos tu tranquilidad con certificaciones digitales perimetrales y respaldo total en cada kilómetro.
      </p>
    </div>

    <!-- 4 Trust Cards Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
      {trustCards.map((card) => (
        <div
          class="p-6 rounded-[24px] bg-white border border-[#E8ECF3] shadow-xs hover:shadow-md hover:border-[#2E4E8F]/40 transition-all duration-300 flex flex-col justify-between group"
        >
          <div class="w-12 h-12 rounded-2xl bg-[#EEF2F6] group-hover:bg-[#0C1120] text-[#2E4E8F] group-hover:text-white flex items-center justify-center mb-6 transition-all duration-300 shadow-2xs">
            {card.icon === "file-text" && (
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
            )}
            {card.icon === "shield-check" && (
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            )}
            {card.icon === "calculator" && (
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
              </svg>
            )}
            {card.icon === "headphones" && (
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z" />
              </svg>
            )}
          </div>

          <div class="flex flex-col gap-2">
            <h3 class="text-base sm:text-lg font-bold text-[#0C1120] font-[Manrope,system-ui,sans-serif] tracking-tight group-hover:text-[#2E4E8F] transition-colors">
              {card.title}
            </h3>
            <p class="text-xs sm:text-sm text-[#4B5563] leading-relaxed">
              {card.desc}
            </p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
