---
import FlotaxIsotype from '../ui/FlotaxIsotype.astro';

interface Props {
  user?: {
    id: string;
    email?: string | null | undefined;
    name?: string | null | undefined;
    image?: string | null | undefined;
  } | null | undefined;
  usuario?: {
    nombre?: string | null | undefined;
    rol?: string | null | undefined;
    imagen?: string | null | undefined;
  } | null | undefined;
}

const { user = null, usuario = null } = Astro.props;
---

<header
  id="main-header"
  data-pencil-name="Header"
  class="sticky top-2 sm:top-3 md:top-4 z-50 w-full transition-all duration-300 transform-gpu will-change-transform translate-y-0 opacity-100 px-3 sm:px-4 md:px-6"
>
  <div class="max-w-4xl lg:max-w-5xl mx-auto">
    <div
      class="w-full h-11 sm:h-12 flex items-center justify-between px-3.5 sm:px-4 md:px-5 rounded-full bg-white shadow-xs"
    >
      <!-- Brand Logo (Sin fondo circular, sin zoom, logo ampliado) -->
      <a
        href="/"
        data-pencil-name="Brand"
        class="flex items-center gap-2 select-none"
        aria-label="Inicio FlotaX"
      >
        <div
          data-pencil-name="Logo"
          class="flex items-center justify-center text-[#111827]"
        >
          <FlotaxIsotype size={26} fill="#111827" />
        </div>
        <span
          data-pencil-name="BrandName"
          class="text-base sm:text-lg font-extrabold text-[#111827] font-[Manrope,system-ui,sans-serif] tracking-tight"
        >
          Flota<span>X</span>
        </span>
      </a>

      <!-- Desktop Navigation Links (Textos negros con grosor font-medium de Cómo funciona) -->
      <nav
        class="hidden md:flex items-center gap-5 lg:gap-6 text-xs lg:text-[13px] font-medium text-[#111827]"
        aria-label="Navegación principal"
      >
        <a
          href="#vehiculos"
          class="hover:text-[#4B5563] transition-colors py-0.5">Vehículos</a
        >
        <a
          href="#categorias"
          class="hover:text-[#4B5563] transition-colors py-0.5">Categorías</a
        >
        <a
          href="#proceso"
          class="hover:text-[#4B5563] transition-colors py-0.5"
          >Cómo funciona</a
        >
        <a
          href="#tarifas"
          class="hover:text-[#4B5563] transition-colors py-0.5">Tarifas</a
        >
        <a
          href="#confianza"
          class="hover:text-[#4B5563] transition-colors py-0.5">Seguridad</a
        >
      </nav>

      <!-- Right CTAs & Profile Actions -->
      <div class="flex items-center gap-2 sm:gap-2.5">
        {
          user ? (
            <a
              href="/home"
              class="inline-flex h-8 sm:h-8.5 items-center justify-center rounded-full bg-[#0C1120] px-3.5 sm:px-4 text-xs font-bold text-white shadow-xs hover:bg-[#1F2937] active:scale-[0.98] transition-all"
            >
              {usuario?.nombre ? `Panel (${usuario.nombre})` : "Ir al Panel"}
              <span class="ml-1 opacity-70">→</span>
            </a>
          ) : (
            <a
              href="/login"
              class="inline-flex h-8 sm:h-8.5 items-center justify-center rounded-full bg-[#0C1120] px-3.5 sm:px-4 text-xs font-bold text-white shadow-xs hover:bg-[#1F2937] active:scale-[0.98] transition-all"
            >
              Iniciar sesión
            </a>
          )
        }

        <!-- Mobile Profile Button -->
        <a
          href={user ? "/home" : "/login"}
          data-pencil-name="ProfileBtn"
          class="md:hidden w-8 h-8 flex items-center justify-center rounded-full bg-white/80 text-[#0C1120] border border-white/60 shadow-xs overflow-hidden active:scale-95 transition-all"
          aria-label={user ? "Abrir panel" : "Iniciar sesión"}
        >
          {user && (usuario?.imagen || user.image) ? (
            <img
              src={usuario?.imagen || user.image!}
              alt={usuario?.nombre || user.name || "Perfil"}
              referrerpolicy="no-referrer"
              class="w-full h-full object-cover"
            />
          ) : (
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              class="w-3.5 h-3.5"
            >
              <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
              <circle cx="12" cy="7" r="4"></circle>
            </svg>
          )}
        </a>
      </div>
    </div>
  </div>
</header>
