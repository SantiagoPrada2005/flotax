---
// src/components/landing/LandingFinalCta.astro
// CTA Final Centrado (Pirámide Invertida, Enfoque Visual al Botón y Auto Centrado Abajo)
---

<section
  id="reservar"
  data-pencil-name="FinalCTA"
  class="w-full pt-12 sm:pt-16 md:pt-20 pb-16 sm:pb-20 md:pb-24 relative z-10"
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 flex flex-col items-center text-center">
    
    <!-- Eyebrow -->
    <span class="text-base sm:text-lg font-medium text-[#111827] tracking-tight">
      ¿Listo para ir?
    </span>

    <!-- Título en Pirámide Invertida (V) -->
    <h2 class="mt-3 text-3xl sm:text-4xl md:text-5xl font-medium text-[#111827] tracking-tight leading-[1.14] max-w-2xl">
      Reserva tu vehículo estés donde estés y conduce hoy mismo.
    </h2>

    <!-- Botón de Acción Centrado -->
    <div class="mt-6 sm:mt-7">
      <a
        href="/catalogo"
        data-pencil-name="CtaButton"
        class="h-12 sm:h-13 px-8 rounded-full bg-[#111827] hover:bg-[#1F2937] active:scale-[0.98] text-white text-sm sm:text-base font-semibold inline-flex items-center justify-center gap-2.5 transition-all shadow-sm group"
      >
        <span>Reservar ahora</span>
        <span class="group-hover:translate-x-1 transition-transform" aria-hidden="true">→</span>
      </a>
    </div>

    <!-- Imagen del Auto Centrado Abajo -->
    <div class="mt-8 sm:mt-10 w-full max-w-2xl flex items-center justify-center select-none pointer-events-none">
      <img
        src="/images/landing/cta-car.webp"
        alt="Vehículo FlotaX listo para conducir"
        class="w-full max-w-[640px] h-auto object-contain"
        loading="lazy"
        decoding="async"
      />
    </div>

  </div>
</section>
