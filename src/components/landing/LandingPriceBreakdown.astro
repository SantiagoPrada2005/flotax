---
// src/components/landing/LandingPriceBreakdown.astro
// Sección: ¿Por qué elegirnos? (Espaciado Ergonómico Sin Estiramiento, Card de Auto Sin Borde)
---

<section
  id="tarifas"
  data-pencil-name="WhyChooseUsSection"
  class="w-full py-16 sm:py-20 md:py-24 relative z-10 reveal-on-scroll bg-[#F5F5F5]"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Grid: Beneficios a la izquierda + Card de Imagen a la derecha -->
    <div class="w-full grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-14 items-center">
      
      <!-- Columna Izquierda: ¿Por qué elegirnos? + Lista de Beneficios (Espaciado Ergonómico Compacto) -->
      <div class="lg:col-span-6 flex flex-col items-start text-left">
        <!-- Título y Eyebrow -->
        <div class="flex flex-col gap-2">
          <span class="text-lg sm:text-xl font-medium text-[#111827] tracking-tight leading-snug">
            ¿Por qué elegirnos?
          </span>
          <h2 class="text-3xl sm:text-4xl md:text-[42px] font-medium text-[#111827] tracking-tight leading-[1.12]">
            Tu alquiler en segundos, sin esperas y sin estrés.
          </h2>
        </div>

        <!-- Lista de Características (Opacas, sin saturar, iconos sin fondo) -->
        <div class="mt-6 flex flex-col gap-3.5">
          <div class="flex items-center gap-3">
            <svg class="w-5 h-5 text-[#9CA3AF] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span class="text-sm sm:text-base font-normal text-[#4B5563]">Sin cargos ocultos</span>
          </div>

          <div class="flex items-center gap-3">
            <svg class="w-5 h-5 text-[#9CA3AF] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span class="text-sm sm:text-base font-normal text-[#4B5563]">Depósito 100% reembolsable</span>
          </div>

          <div class="flex items-center gap-3">
            <svg class="w-5 h-5 text-[#9CA3AF] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span class="text-sm sm:text-base font-normal text-[#4B5563]">Seguro y peritaje R2 incluido</span>
          </div>

          <div class="flex items-center gap-3">
            <svg class="w-5 h-5 text-[#9CA3AF] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span class="text-sm sm:text-base font-normal text-[#4B5563]">Disponibilidad y soporte 24/7</span>
          </div>
        </div>

        <!-- Botón de Acción con Separación Precisa -->
        <div class="mt-7 sm:mt-8">
          <a
            href="/catalogo"
            class="h-11 sm:h-12 px-7 rounded-full bg-[#111827] hover:bg-[#1F2937] active:scale-[0.98] text-white text-xs sm:text-sm font-semibold inline-flex items-center justify-center gap-2 transition-all w-fit"
          >
            <span>Reservar ahora</span>
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      <!-- Columna Derecha: Card de Imagen de Auto (Sin Borde, Ocupa Toda la Card, Altura Acoplada al Contenido) -->
      <div class="lg:col-span-6 flex items-center justify-center">
        <div class="w-full max-h-[380px] aspect-[4/3] sm:aspect-square lg:aspect-auto lg:h-[370px] rounded-[32px] overflow-hidden relative">
          <img
            src="/images/landing/why-choose-car.webp"
            alt="Vehículo FlotaX"
            class="w-full h-full object-cover select-none"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>

    </div>

  </div>
</section>
