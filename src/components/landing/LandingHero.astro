---
// src/components/landing/LandingHero.astro
import { LandingBookingIsland } from './LandingBookingIsland';
---

<section
  id="hero"
  data-pencil-name="HeroSection"
  class="relative w-full min-h-[660px] sm:min-h-[720px] lg:min-h-[760px] flex flex-col justify-between overflow-hidden bg-[#1E3A8A]"
>
  <!-- Background Image with Luminous Cerulean Sky & Seamless Bottom Fade -->
  <div class="absolute inset-0 z-0 select-none pointer-events-none">
    <img
      src="/images/landing/hero-vehicle-luminous.webp"
      alt="Vehículo de alta gama en plataforma FlotaX"
      class="w-full h-full object-cover object-center"
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
    <!-- Clean Bottom Fade to Soft Canvas for Fluid Transition into Fleet Section -->
    <div class="absolute bottom-0 inset-x-0 h-24 bg-gradient-to-t from-[#F5F5F5] dark:from-[#111827] via-[#F5F5F5]/40 dark:via-[#111827]/40 to-transparent transition-colors"></div>
  </div>

  <!-- Primary Foreground Content: Centered V-Shaped Headline & Lifted Booking Bar -->
  <div
    class="relative z-10 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-24 sm:pt-28 md:pt-32 pb-8 sm:pb-12 md:pb-14 flex flex-col justify-between flex-1 gap-12 sm:gap-16 md:gap-20"
  >
    <!-- Value Proposition V-Shaped Header (Flat White, No Drop-Shadows, Eye-Funnel Down) -->
    <div class="w-full max-w-4xl mx-auto flex flex-col items-center text-center">
      <h1
        class="text-4xl sm:text-5xl md:text-6xl lg:text-[64px] font-black font-[Manrope,system-ui,sans-serif] text-white leading-[1.05] tracking-tight drop-shadow-none"
      >
        Alquila tu próximo vehículo
        <br />
        <span class="block mt-1 sm:mt-1.5 text-white">desde tu hogar</span>
      </h1>
    </div>

    <!-- Integrated Search Booking Command Island (Lifted into Hero, Resting on Pale Ground) -->
    <div class="w-full mt-auto">
      <LandingBookingIsland client:load />
    </div>
  </div>
</section>
