---
import type { EstadoSesionCaja } from '@/db/schema';

interface Props {
  availableCount?: number | undefined;
  availableLabel?: string | undefined;
  availableTrend?: string | undefined;
  revenueAmount?: string | undefined;
  revenueTrend?: string | undefined;
  shiftStatus?: EstadoSesionCaja | 'Abierto' | 'Cerrado' | undefined;
}

const {
  availableCount = 14,
  availableLabel = 'Disponibles',
  availableTrend = '14 en patio',
  revenueAmount = '$ 1.450.000',
  revenueTrend = 'Capacidad/día',
  shiftStatus = 'ABIERTA',
} = Astro.props;

const isShiftOpen =
  shiftStatus === 'ABIERTA' || shiftStatus === 'Abierto';
const shiftStatusLabel = isShiftOpen ? 'Abierto' : 'Cerrado';
---

<div class="contents">
  <!-- Fila 1: Caja Turno (En celulares orden 2, en computadores fila 1 columna 2 junto a Ocupación) -->
  <article
    class="order-2 md:col-start-2 md:row-start-1 relative overflow-hidden rounded-[30px] bg-[#111827] p-6 text-white shadow-xl h-full flex flex-col justify-between"
  >
    <!-- Decorative Background Ring for visual depth -->
    <div
      class="pointer-events-none absolute -right-12 -top-12 h-44 w-44 rounded-full bg-white/5 blur-2xl"
      aria-hidden="true"
    ></div>

    <div class="relative z-10 flex items-center justify-between gap-4">
      <!-- Columna Izquierda: Título "Caja Turno" y monto de liquidaciones del día -->
      <div class="flex min-w-0 flex-1 flex-col space-y-3">
        <!-- Tag Pill -->
        <div class="inline-flex items-center gap-1.5 self-start rounded-full bg-white/10 px-3 py-1 text-xs font-medium text-white/90 backdrop-blur-md">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-3.5 w-3.5 shrink-0"
          >
            <line x1="12" x2="12" y1="2" y2="22"></line>
            <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
          </svg>
          <span>Caja Turno</span>
        </div>

        <!-- Monto principal y subtítulo sin desbordamiento -->
        <div class="min-w-0">
          <p class="font-display text-3xl font-extrabold tracking-tight sm:text-4xl truncate">
            {revenueAmount}
          </p>
          <div class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs font-medium text-[#9CA3AF]">
            <span>Liquidaciones del día</span>
            {revenueTrend && (
              <>
                <span aria-hidden="true">•</span>
                <span class="inline-flex items-center gap-0.5 font-semibold text-emerald-400">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="h-3 w-3 shrink-0"
                  >
                    <path d="m18 15-6-6-6 6"></path>
                  </svg>
                  <span>{revenueTrend}</span>
                </span>
              </>
            )}
          </div>
        </div>
      </div>

      <!-- Columna Derecha: Estado del turno (Abierto/Cerrado) en caja blanca tipo "0 de 0 activas" -->
      <div
        class="flex h-28 w-28 shrink-0 flex-col items-center justify-center rounded-[22px] bg-white p-3 text-center text-[#111827] shadow-lg ring-1 ring-black/5 sm:h-32 sm:w-32"
      >
        <span class="font-display text-xl font-black tracking-tight sm:text-2xl">
          {shiftStatusLabel}
        </span>
        <span class="mt-0.5 text-[10px] font-semibold uppercase tracking-wider text-[#4B5563]">
          Estado Turno
        </span>
        <span
          class:list={[
            'mt-1.5 inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-[10px] font-bold',
            isShiftOpen
              ? 'bg-emerald-50 text-emerald-700'
              : 'bg-[#EDEDED] text-[#4B5563]',
          ]}
        >
          <span
            class:list={[
              'h-1.5 w-1.5 rounded-full',
              isShiftOpen ? 'bg-emerald-600' : 'bg-[#9CA3AF]',
            ]}
          ></span>
          {isShiftOpen ? 'Operativo' : 'Cerrado'}
        </span>
      </div>
    </div>
  </article>

  <!-- Fila 2: Disponibles (En celulares orden 3, en computadores fila 2 columna 1 al lado de Catálogo) -->
  <article
    class="order-3 md:col-start-1 md:row-start-2 flex flex-col justify-between rounded-[26px] bg-[#1F2937] p-5 text-white shadow-md h-full"
  >
    <div class="flex items-center gap-2">
      <div class="flex h-7 w-7 items-center justify-center rounded-full bg-white/10 text-white/90">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="h-4 w-4"
        >
          <path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2"></path>
          <circle cx="7" cy="17" r="2"></circle>
          <path d="M9 17h6"></path>
          <circle cx="17" cy="17" r="2"></circle>
        </svg>
      </div>
      <span class="text-xs font-medium text-[#9CA3AF]">{availableLabel}</span>
    </div>

    <div class="mt-4">
      <p class="font-display text-3xl font-extrabold tracking-tight">
        {availableCount} <span class="text-sm font-semibold text-[#9CA3AF]">unds</span>
      </p>
      <div class="mt-1.5 inline-flex items-center gap-1 text-[11px] font-medium text-emerald-400">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="h-3 w-3"
        >
          <path d="m18 15-6-6-6 6"></path>
        </svg>
        <span>{availableTrend}</span>
      </div>
    </div>
  </article>
</div>
