---
interface Props {
  availableCount?: number | undefined;
  availableLabel?: string | undefined;
  availableTrend?: string | undefined;
  revenueAmount?: string | undefined;
  revenueTrend?: string | undefined;
}

const {
  availableCount = 14,
  availableLabel = 'Disponibles',
  availableTrend = '+3 listas hoy',
  revenueAmount = '$1,450',
  revenueTrend = '+8.4%',
} = Astro.props;
---

<div class="grid grid-cols-2 gap-3.5 sm:gap-4">
  <!-- Card 1 (Left): Flota Disponible / Unidades Listas -->
  <article
    class="flex flex-col justify-between rounded-[26px] bg-[#1F2937] p-5 text-white shadow-md transition-all duration-200 hover:shadow-lg"
  >
    <div class="flex items-center gap-2">
      <div class="flex h-7 w-7 items-center justify-center rounded-full bg-white/10 text-white/90">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="h-4 w-4"
        >
          <path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2"></path>
          <circle cx="7" cy="17" r="2"></circle>
          <path d="M9 17h6"></path>
          <circle cx="17" cy="17" r="2"></circle>
        </svg>
      </div>
      <span class="text-xs font-medium text-[#9CA3AF]">{availableLabel}</span>
    </div>

    <div class="mt-4">
      <p class="font-display text-3xl font-extrabold tracking-tight">
        {availableCount} <span class="text-sm font-semibold text-[#9CA3AF]">unds</span>
      </p>
      <div class="mt-1.5 inline-flex items-center gap-1 text-[11px] font-medium text-emerald-400">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="h-3 w-3"
        >
          <path d="m18 15-6-6-6 6"></path>
        </svg>
        <span>{availableTrend}</span>
      </div>
    </div>
  </article>

  <!-- Card 2 (Right): Cobros del Turno con Micro Sparkline Waveform -->
  <article
    class="relative flex flex-col justify-between overflow-hidden rounded-[26px] bg-white p-5 text-[#111827] shadow-md border border-[#9CA3AF]/30 transition-all duration-200 hover:shadow-lg"
  >
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-1.5">
        <div class="flex h-7 w-7 items-center justify-center rounded-full bg-[#111827]/5 text-[#111827]">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-4 w-4"
          >
            <line x1="12" x2="12" y1="2" y2="22"></line>
            <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
          </svg>
        </div>
        <span class="text-xs font-semibold text-[#4B5563]">Caja Turno</span>
      </div>

      <!-- Trend Badge -->
      <span class="inline-flex items-center gap-0.5 text-[11px] font-bold text-emerald-600">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="h-3 w-3"
        >
          <path d="m18 15-6-6-6 6"></path>
        </svg>
        {revenueTrend}
      </span>
    </div>

    <!-- Micro Sparkline Waveform (Emulating reference wave curve with plotted point) -->
    <div class="my-2 h-7 w-full overflow-visible py-1">
      <svg
        viewBox="0 0 100 24"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        class="h-full w-full overflow-visible"
        preserveAspectRatio="none"
      >
        <path
          d="M0 16 C 15 16, 20 8, 35 12 C 50 16, 60 4, 75 14 C 85 20, 92 6, 100 8"
          stroke="#111827"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <!-- Active plotted node as in the reference image -->
        <circle cx="75" cy="14" r="3" fill="#111827" stroke="white" stroke-width="1.5" />
      </svg>
    </div>

    <div>
      <p class="font-display text-3xl font-extrabold tracking-tight text-[#111827]">
        {revenueAmount}
      </p>
      <p class="text-[10px] font-medium text-[#4B5563]">Liquidaciones del día</p>
    </div>
  </article>
</div>
