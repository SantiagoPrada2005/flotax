---
interface Props {
  title?: string | undefined;
  showBack?: boolean | undefined;
  backHref?: string | undefined;
  class?: string | undefined;
}

const { title = 'FlotaX', showBack = false, backHref = '/', class: className = '' } = Astro.props;
---

<!-- Floating Actions Header (No solid bar, only floating pills with pointer-events pass-through) -->
<header
  class:list={[
    "fixed top-0 left-0 right-0 z-30 pointer-events-none flex h-16 items-center justify-between px-4 sm:px-6 bg-transparent",
    className
  ]}
>
  <!-- Left Floating Controls -->
  <div class="pointer-events-auto flex items-center gap-2.5">
    {showBack ? (
      <a
        href={backHref}
        aria-label="Volver"
        class="flex h-11 w-11 items-center justify-center rounded-full bg-white/95 text-[#111827] border border-[#9CA3AF]/40 shadow-md backdrop-blur-md transition hover:scale-105 active:scale-95"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="h-5 w-5"
        >
          <path d="m15 18-6-6 6-6"></path>
        </svg>
      </a>
    ) : (
      <>
        <!-- Mobile Native Floating Menu Icon -->
        <button
          type="button"
          aria-label="Menú principal"
          class="flex h-11 w-11 items-center justify-center rounded-full bg-white/95 text-[#111827] border border-[#9CA3AF]/40 shadow-md backdrop-blur-md transition hover:scale-105 active:scale-95 md:hidden"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-5 w-5"
          >
            <line x1="4" x2="20" y1="7" y2="7"></line>
            <line x1="4" x2="16" y1="12" y2="12"></line>
            <line x1="4" x2="12" y1="17" y2="17"></line>
          </svg>
        </button>

        <!-- Desktop Contextual Title Pill (Floating) -->
        {title && (
          <div class="hidden items-center gap-2 rounded-full bg-white/95 px-3.5 py-1.5 shadow-md border border-[#9CA3AF]/30 backdrop-blur-md md:flex">
            <span class="text-xs font-bold uppercase tracking-wider text-[#4B5563]">
              {title}
            </span>
          </div>
        )}
      </>
    )}
  </div>

  <!-- Right Floating Controls -->
  <div class="pointer-events-auto flex items-center gap-2 sm:gap-2.5">
    <!-- Live Fleet Status Pill on tablet/desktop -->
    <div class="hidden items-center gap-1.5 rounded-full bg-white/95 px-3 py-1.5 text-xs font-semibold text-[#1F2937] shadow-md border border-[#9CA3AF]/30 backdrop-blur-md sm:flex">
      <span class="h-2 w-2 rounded-full bg-emerald-600 animate-pulse"></span>
      <span class="font-mono text-[11px]">En Vivo</span>
    </div>

    <!-- Quick Search button (Floating Circular Pill) -->
    <button
      type="button"
      aria-label="Buscar unidades"
      class="flex h-11 w-11 items-center justify-center rounded-full bg-white/95 text-[#4B5563] border border-[#9CA3AF]/40 shadow-md backdrop-blur-md transition hover:text-[#111827] hover:scale-105 active:scale-95"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="h-4.5 w-4.5"
      >
        <circle cx="11" cy="11" r="8"></circle>
        <path d="m21 21-4.3-4.3"></path>
      </svg>
    </button>

    <!-- Notifications Button (Floating Circular Pill with badge) -->
    <button
      type="button"
      aria-label="Notificaciones"
      class="relative flex h-11 w-11 items-center justify-center rounded-full bg-white/95 text-[#4B5563] border border-[#9CA3AF]/40 shadow-md backdrop-blur-md transition hover:text-[#111827] hover:scale-105 active:scale-95"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="h-4.5 w-4.5"
      >
        <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"></path>
        <path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"></path>
      </svg>
      <span class="absolute right-2.5 top-2.5 h-2 w-2 rounded-full bg-emerald-600 ring-2 ring-white"></span>
    </button>

    <!-- User Profile Avatar (Floating Circular Pill) -->
    <a
      href="/perfil"
      aria-label="Perfil de usuario"
      class="flex h-11 w-11 items-center justify-center rounded-full bg-[#111827] text-white border-2 border-white shadow-md text-xs font-bold transition hover:scale-105 active:scale-95"
    >
      FX
    </a>
  </div>
</header>
