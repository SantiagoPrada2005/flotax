---
import { env } from 'cloudflare:workers';
import TopBarIsland from './TopBarIsland';

interface Props {
  title?: string | undefined;
  showBack?: boolean | undefined;
  backHref?: string | undefined;
  navVariant?: 'admin' | 'client' | undefined;
  class?: string | undefined;
}

const {
  title = 'FlotaX',
  showBack = false,
  backHref = '/',
  navVariant = 'client',
  class: className = '',
} = Astro.props;

const usuario = Astro.locals.usuario;
const autenticado = Boolean(usuario);
const usuarioImagen = usuario?.imagen ?? null;
const usuarioNombre = usuario?.nombre ?? null;
const usuarioCorreo = usuario?.correo ?? null;
const usuarioLocalNombre = usuario?.localActivo?.nombre ?? null;
const tieneAccesoAdmin = Boolean(usuario?.localActivo || usuario?.esSuperAdmin);
const modoPortal = Astro.locals.modoPortal;
const localCaptacion = Astro.locals.localCaptacion;
---

<TopBarIsland
  client:load
  title={localCaptacion ? localCaptacion.nombre : title}
  showBack={showBack}
  backHref={backHref}
  navVariant={navVariant}
  className={className}
  autenticado={autenticado}
  usuarioImagen={usuarioImagen}
  usuarioNombre={usuarioNombre}
  usuarioCorreo={usuarioCorreo}
  usuarioLocalNombre={usuarioLocalNombre}
  tieneAccesoAdmin={tieneAccesoAdmin}
  modoPortal={modoPortal}
  clavePublicaVapid={env.VAPID_PUBLIC_KEY}
  localCaptacionNombre={localCaptacion?.nombre}
/>
