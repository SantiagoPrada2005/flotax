---
interface Props {
  title?: string | undefined;
  showBack?: boolean | undefined;
  backHref?: string | undefined;
}

const { title = 'FlotaX', showBack = false, backHref = '/' } = Astro.props;
---

<header
  class="sticky top-0 z-30 flex h-14 w-full items-center justify-between border-b border-border-subtle bg-surface-card/90 px-4 backdrop-blur-md transition-colors sm:px-6"
>
  <div class="flex items-center gap-3">
    {showBack ? (
      <a
        href={backHref}
        aria-label="Volver"
        class="flex h-9 w-9 items-center justify-center rounded-full text-brand-primary transition hover:bg-surface-elevated active:scale-95"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="h-5 w-5"
        >
          <path d="m15 18-6-6 6-6"></path>
        </svg>
      </a>
    ) : (
      <a href="/" class="flex items-center gap-2.5">
        <div class="flex h-8 w-8 items-center justify-center rounded-[10px] bg-brand-primary text-white shadow-xs">
          <span class="font-display text-sm font-bold leading-none">M</span>
        </div>
        <span class="font-display text-base font-bold tracking-tight text-brand-primary">
          Flota<span class="text-brand-coral">X</span>
        </span>
      </a>
    )}

    {title && !showBack && (
      <div class="hidden items-center gap-2 border-l border-border-subtle pl-3 md:flex">
        <span class="text-xs font-medium uppercase tracking-wider text-neutral-500">
          {title}
        </span>
      </div>
    )}
  </div>

  <div class="flex items-center gap-2">
    <!-- Live Fleet Status Indicator -->
    <div class="hidden items-center gap-1.5 rounded-full bg-surface-elevated px-2.5 py-1 text-xs font-medium text-neutral-600 sm:flex border border-border-subtle">
      <span class="h-2 w-2 rounded-full bg-status-success animate-pulse"></span>
      <span class="font-mono text-[11px]">En Vivo</span>
    </div>

    <!-- Quick Search button -->
    <button
      type="button"
      aria-label="Buscar"
      class="flex h-9 w-9 items-center justify-center rounded-xl text-neutral-600 transition hover:bg-surface-elevated hover:text-brand-primary active:scale-95"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="h-4 w-4"
      >
        <circle cx="11" cy="11" r="8"></circle>
        <path d="m21 21-4.3-4.3"></path>
      </svg>
    </button>

    <!-- User profile avatar / pill -->
    <a
      href="/perfil"
      aria-label="Perfil de usuario"
      class="flex h-8 w-8 items-center justify-center rounded-full bg-surface-canvas border border-border-subtle text-xs font-semibold text-brand-primary transition hover:border-brand-primary"
    >
      AD
    </a>
  </div>
</header>
