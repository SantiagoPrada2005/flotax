---
import { env } from 'cloudflare:workers';
import TopBarIsland from './TopBarIsland';

interface Props {
  title?: string | undefined;
  showBack?: boolean | undefined;
  backHref?: string | undefined;
  class?: string | undefined;
}

const { title = 'FlotaX', showBack = false, backHref = '/', class: className = '' } = Astro.props;
const autenticado = Boolean(Astro.locals.usuario);
---

<TopBarIsland
  client:load
  title={title}
  showBack={showBack}
  backHref={backHref}
  className={className}
  autenticado={autenticado}
  clavePublicaVapid={env.VAPID_PUBLIC_KEY}
/>
