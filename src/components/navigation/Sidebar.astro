---
interface Props {
  activeTab?: 'home' | 'search' | 'fleet' | 'wallet' | 'profile' | undefined;
}

const { activeTab } = Astro.props;
const currentPath = Astro.url.pathname;

const isHome = activeTab ? activeTab === 'home' : (currentPath === '/home' || currentPath === '/dashboard');
const isSearch = activeTab ? activeTab === 'search' : currentPath.startsWith('/reservas') || currentPath.startsWith('/buscar');
const isFleet = activeTab ? activeTab === 'fleet' : currentPath.startsWith('/vehiculos') || currentPath.startsWith('/flota');
const isWallet = activeTab ? activeTab === 'wallet' : currentPath.startsWith('/pagos') || currentPath.startsWith('/finanzas');
---

<aside class="hidden w-64 shrink-0 flex-col border-r border-border-subtle bg-surface-sidebar p-4 md:flex h-screen sticky top-0 overflow-y-auto">
  <!-- Brand Header -->
  <a href="/home" class="flex items-center gap-3 px-2 py-3 transition hover:opacity-90">
    <div class="flex h-9 w-9 items-center justify-center rounded-[10px] bg-brand-primary text-white shadow-xs">
      <span class="font-display text-base font-bold leading-none">M</span>
    </div>
    <div class="flex flex-col">
      <span class="font-display text-lg font-bold tracking-tight text-brand-primary">
        Flota<span class="text-brand-coral">X</span>
      </span>
      <span class="text-[10px] font-mono uppercase tracking-wider text-neutral-500">
        Gestión Perimetral
      </span>
    </div>
  </a>

  <!-- Action Button: Nueva Reserva -->
  <div class="my-4">
    <a
      href="/reservas/nueva"
      class="flex w-full items-center justify-center gap-2 rounded-input bg-brand-secondary px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-brand-primary active:scale-[0.98]"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="h-4 w-4"
      >
        <path d="M5 12h14"></path>
        <path d="M12 5v14"></path>
      </svg>
      <span>Nueva Reserva</span>
    </a>
  </div>

  <!-- Navigation Links -->
  <nav class="flex flex-1 flex-col gap-1 py-2 font-medium text-sm">
    <a
      href="/home"
      aria-current={isHome ? "page" : undefined}
      class:list={[
        "flex items-center gap-3 rounded-input px-3 py-2.5 transition-colors",
        isHome
          ? "bg-surface-card text-brand-primary font-semibold shadow-xs border border-border-subtle"
          : "text-neutral-600 hover:bg-surface-elevated hover:text-brand-primary"
      ]}
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width={isHome ? "2.2" : "1.8"}
        stroke-linecap="round"
        stroke-linejoin="round"
        class="h-5 w-5"
      >
        <path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"></path>
        <path d="M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
      </svg>
      <span>Panel General</span>
    </a>

    <a
      href="/reservas"
      aria-current={isSearch ? "page" : undefined}
      class:list={[
        "flex items-center gap-3 rounded-input px-3 py-2.5 transition-colors",
        isSearch
          ? "bg-surface-card text-brand-primary font-semibold shadow-xs border border-border-subtle"
          : "text-neutral-600 hover:bg-surface-elevated hover:text-brand-primary"
      ]}
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width={isSearch ? "2.2" : "1.8"}
        stroke-linecap="round"
        stroke-linejoin="round"
        class="h-5 w-5"
      >
        <circle cx="11" cy="11" r="8"></circle>
        <path d="m21 21-4.3-4.3"></path>
      </svg>
      <span>Reservas & Rentas</span>
    </a>

    <a
      href="/vehiculos"
      aria-current={isFleet ? "page" : undefined}
      class:list={[
        "flex items-center gap-3 rounded-input px-3 py-2.5 transition-colors",
        isFleet
          ? "bg-surface-card text-brand-primary font-semibold shadow-xs border border-border-subtle"
          : "text-neutral-600 hover:bg-surface-elevated hover:text-brand-primary"
      ]}
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width={isFleet ? "2.2" : "1.8"}
        stroke-linecap="round"
        stroke-linejoin="round"
        class="h-5 w-5"
      >
        <path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2"></path>
        <circle cx="7" cy="17" r="2"></circle>
        <path d="M9 17h6"></path>
        <circle cx="17" cy="17" r="2"></circle>
      </svg>
      <span>Flota de Vehículos</span>
    </a>

    <a
      href="/pagos"
      aria-current={isWallet ? "page" : undefined}
      class:list={[
        "flex items-center gap-3 rounded-input px-3 py-2.5 transition-colors",
        isWallet
          ? "bg-surface-card text-brand-primary font-semibold shadow-xs border border-border-subtle"
          : "text-neutral-600 hover:bg-surface-elevated hover:text-brand-primary"
      ]}
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width={isWallet ? "2.2" : "1.8"}
        stroke-linecap="round"
        stroke-linejoin="round"
        class="h-5 w-5"
      >
        <path d="M19 7V4a1 1 0 0 0-1-1H5a2 2 0 0 0 0 4h15a1 1 0 0 1 1 1v4h-3a2 2 0 0 0 0 4h3a1 1 0 0 0 1-1v-2a1 1 0 0 0-1-1"></path>
        <path d="M3 5v14a2 2 0 0 0 2 2h15a1 1 0 0 0 1-1v-4"></path>
      </svg>
      <span>Finanzas & Pagos</span>
    </a>
  </nav>

  <!-- User / Footer Info -->
  <div class="mt-auto border-t border-border-subtle pt-4">
    <div class="flex items-center gap-3 px-2">
      <div class="flex h-9 w-9 items-center justify-center rounded-full bg-surface-canvas border border-border-subtle text-xs font-semibold text-brand-primary">
        AD
      </div>
      <div class="flex flex-col truncate">
        <span class="text-xs font-semibold text-brand-primary truncate">Administrador</span>
        <span class="font-mono text-[10px] text-neutral-500 truncate">admin@flotax.co</span>
      </div>
    </div>
  </div>
</aside>
