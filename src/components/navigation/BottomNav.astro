---
import BottomNavIsland from './BottomNavIsland';

interface Props {
  activeTab?: 'home' | 'search' | 'fleet' | 'wallet' | 'profile' | undefined;
  variant?: 'admin' | 'client' | undefined;
  class?: string | undefined;
}

const { activeTab, variant = 'client', class: className = '' } = Astro.props;
const currentPath = Astro.url.pathname;
---

<BottomNavIsland
  client:load
  transition:persist="flotax-bottom-nav"
  currentPath={currentPath}
  activeTab={activeTab}
  variant={variant}
  className={className}
/>
