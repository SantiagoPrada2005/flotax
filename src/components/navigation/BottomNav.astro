---
interface Props {
  activeTab?: 'home' | 'search' | 'fleet' | 'wallet' | 'profile' | undefined;
  class?: string | undefined;
}

const { activeTab, class: className = '' } = Astro.props;
const currentPath = Astro.url.pathname;

const isHome = activeTab ? activeTab === 'home' : (currentPath === '/' || currentPath === '/dashboard');
const isSearch = activeTab ? activeTab === 'search' : currentPath.startsWith('/reservas') || currentPath.startsWith('/buscar');
const isFleet = activeTab ? activeTab === 'fleet' : currentPath.startsWith('/vehiculos') || currentPath.startsWith('/flota');
const isWallet = activeTab ? activeTab === 'wallet' : currentPath.startsWith('/pagos') || currentPath.startsWith('/finanzas');
---

<nav
  aria-label="Navegación principal móvil"
  class:list={[
    "fixed bottom-0 left-0 right-0 z-40 md:hidden",
    "bg-surface-card/95 backdrop-blur-md border-t border-border-subtle",
    "safe-bottom transition-all duration-200",
    className
  ]}
>
  <div class="relative mx-auto flex h-[64px] max-w-md items-center justify-between px-6">
    <!-- Tab: Home -->
    <a
      href="/"
      aria-label="Inicio"
      aria-current={isHome ? "page" : undefined}
      class:list={[
        "group relative flex min-h-[44px] min-w-[44px] flex-col items-center justify-center rounded-2xl transition-all duration-150 active:scale-95",
        isHome ? "text-brand-primary font-medium" : "text-[#A29F99] hover:text-brand-primary"
      ]}
    >
      <div class="relative flex items-center justify-center p-1">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width={isHome ? "2.2" : "1.8"}
          stroke-linecap="round"
          stroke-linejoin="round"
          class="h-6 w-6 transition-transform duration-150 group-hover:scale-105"
        >
          <path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"></path>
          <path d="M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
        </svg>
        {isHome && (
          <span class="absolute -bottom-1 h-1 w-1 rounded-full bg-brand-accent"></span>
        )}
      </div>
      <span class="text-[10px] tracking-tight leading-none mt-0.5">Inicio</span>
    </a>

    <!-- Tab: Search / Reservas -->
    <a
      href="/reservas"
      aria-label="Buscar y Reservas"
      aria-current={isSearch ? "page" : undefined}
      class:list={[
        "group relative flex min-h-[44px] min-w-[44px] flex-col items-center justify-center rounded-2xl transition-all duration-150 active:scale-95",
        isSearch ? "text-brand-primary font-medium" : "text-[#A29F99] hover:text-brand-primary"
      ]}
    >
      <div class="relative flex items-center justify-center p-1">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width={isSearch ? "2.2" : "1.8"}
          stroke-linecap="round"
          stroke-linejoin="round"
          class="h-6 w-6 transition-transform duration-150 group-hover:scale-105"
        >
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.3-4.3"></path>
        </svg>
        {isSearch && (
          <span class="absolute -bottom-1 h-1 w-1 rounded-full bg-brand-accent"></span>
        )}
      </div>
      <span class="text-[10px] tracking-tight leading-none mt-0.5">Reservas</span>
    </a>

    <!-- Center Floating Action Button (FAB) 56px -->
    <div class="relative -top-5 flex flex-col items-center justify-center">
      <a
        href="/reservas/nueva"
        id="bottom-nav-fab-btn"
        aria-label="Nueva reserva o contrato"
        class="flex h-14 w-14 items-center justify-center rounded-full bg-brand-secondary text-white shadow-fab transition-all duration-200 hover:scale-105 active:scale-95 hover:bg-brand-primary focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-accent ring-4 ring-surface-card"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="h-6 w-6 transition-transform duration-200 hover:rotate-90"
        >
          <path d="M5 12h14"></path>
          <path d="M12 5v14"></path>
        </svg>
      </a>
      <span class="text-[9px] font-mono tracking-tight text-neutral-500 font-semibold mt-1">Nuevo</span>
    </div>

    <!-- Tab: Fleet / Flota -->
    <a
      href="/vehiculos"
      aria-label="Flota de vehículos"
      aria-current={isFleet ? "page" : undefined}
      class:list={[
        "group relative flex min-h-[44px] min-w-[44px] flex-col items-center justify-center rounded-2xl transition-all duration-150 active:scale-95",
        isFleet ? "text-brand-primary font-medium" : "text-[#A29F99] hover:text-brand-primary"
      ]}
    >
      <div class="relative flex items-center justify-center p-1">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width={isFleet ? "2.2" : "1.8"}
          stroke-linecap="round"
          stroke-linejoin="round"
          class="h-6 w-6 transition-transform duration-150 group-hover:scale-105"
        >
          <path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2"></path>
          <circle cx="7" cy="17" r="2"></circle>
          <path d="M9 17h6"></path>
          <circle cx="17" cy="17" r="2"></circle>
        </svg>
        {isFleet && (
          <span class="absolute -bottom-1 h-1 w-1 rounded-full bg-brand-accent"></span>
        )}
      </div>
      <span class="text-[10px] tracking-tight leading-none mt-0.5">Flota</span>
    </a>

    <!-- Tab: Wallet / Finanzas -->
    <a
      href="/pagos"
      aria-label="Finanzas y Pagos"
      aria-current={isWallet ? "page" : undefined}
      class:list={[
        "group relative flex min-h-[44px] min-w-[44px] flex-col items-center justify-center rounded-2xl transition-all duration-150 active:scale-95",
        isWallet ? "text-brand-primary font-medium" : "text-[#A29F99] hover:text-brand-primary"
      ]}
    >
      <div class="relative flex items-center justify-center p-1">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width={isWallet ? "2.2" : "1.8"}
          stroke-linecap="round"
          stroke-linejoin="round"
          class="h-6 w-6 transition-transform duration-150 group-hover:scale-105"
        >
          <path d="M19 7V4a1 1 0 0 0-1-1H5a2 2 0 0 0 0 4h15a1 1 0 0 1 1 1v4h-3a2 2 0 0 0 0 4h3a1 1 0 0 0 1-1v-2a1 1 0 0 0-1-1"></path>
          <path d="M3 5v14a2 2 0 0 0 2 2h15a1 1 0 0 0 1-1v-4"></path>
        </svg>
        {isWallet && (
          <span class="absolute -bottom-1 h-1 w-1 rounded-full bg-brand-accent"></span>
        )}
      </div>
      <span class="text-[10px] tracking-tight leading-none mt-0.5">Pagos</span>
    </a>
  </div>
</nav>
