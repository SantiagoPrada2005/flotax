---
interface Props {
  activeTab?: 'home' | 'search' | 'fleet' | 'wallet' | 'profile' | undefined;
  class?: string | undefined;
}

const { activeTab, class: className = '' } = Astro.props;
const currentPath = Astro.url.pathname;

const isHome = activeTab ? activeTab === 'home' : (currentPath === '/home' || currentPath === '/dashboard');
const isSearch = activeTab ? activeTab === 'search' : currentPath.startsWith('/reservas') || currentPath.startsWith('/buscar');
const isFleet = activeTab ? activeTab === 'fleet' : currentPath.startsWith('/vehiculos') || currentPath.startsWith('/flota');
const isWallet = activeTab ? activeTab === 'wallet' : currentPath.startsWith('/pagos') || currentPath.startsWith('/finanzas');
---

<nav
  aria-label="Navegación principal móvil"
  class:list={[
    "fixed bottom-6 left-1/2 -translate-x-1/2 z-40 md:hidden",
    "transition-all duration-200 pointer-events-auto",
    className
  ]}
>
  <!-- Floating Island Dock Capsule -->
  <div class="flex items-center gap-1.5 rounded-full bg-white/95 px-2.5 py-1.5 backdrop-blur-xl border border-[#9CA3AF]/40 shadow-[0_16px_36px_-8px_rgba(17,24,39,0.28)] ring-1 ring-black/5">
    <!-- Tab: Home -->
    <a
      href="/home"
      aria-label="Inicio"
      aria-current={isHome ? "page" : undefined}
      class:list={[
        "flex h-11 w-11 items-center justify-center rounded-full transition-all duration-200 active:scale-95",
        isHome
          ? "bg-[#111827] text-white shadow-sm"
          : "text-[#4B5563] hover:text-[#111827] hover:bg-[#EDEDED]/70"
      ]}
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width={isHome ? "2.2" : "1.8"}
        stroke-linecap="round"
        stroke-linejoin="round"
        class="h-5 w-5"
      >
        <path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"></path>
        <path d="M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
      </svg>
    </a>

    <!-- Tab: Flota / Unidades -->
    <a
      href="/vehiculos"
      aria-label="Flota de vehículos"
      aria-current={isFleet ? "page" : undefined}
      class:list={[
        "flex h-11 w-11 items-center justify-center rounded-full transition-all duration-200 active:scale-95",
        isFleet
          ? "bg-[#111827] text-white shadow-sm"
          : "text-[#4B5563] hover:text-[#111827] hover:bg-[#EDEDED]/70"
      ]}
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width={isFleet ? "2.2" : "1.8"}
        stroke-linecap="round"
        stroke-linejoin="round"
        class="h-5 w-5"
      >
        <path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2"></path>
        <circle cx="7" cy="17" r="2"></circle>
        <path d="M9 17h6"></path>
        <circle cx="17" cy="17" r="2"></circle>
      </svg>
    </a>

    <!-- Tab: Reservas / Actividad -->
    <a
      href="/reservas"
      aria-label="Reservas y Contratos"
      aria-current={isSearch ? "page" : undefined}
      class:list={[
        "flex h-11 w-11 items-center justify-center rounded-full transition-all duration-200 active:scale-95",
        isSearch
          ? "bg-[#111827] text-white shadow-sm"
          : "text-[#4B5563] hover:text-[#111827] hover:bg-[#EDEDED]/70"
      ]}
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width={isSearch ? "2.2" : "1.8"}
        stroke-linecap="round"
        stroke-linejoin="round"
        class="h-5 w-5"
      >
        <path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"></path>
      </svg>
    </a>

    <!-- Tab: Finanzas / Pagos -->
    <a
      href="/pagos"
      aria-label="Finanzas y Pagos"
      aria-current={isWallet ? "page" : undefined}
      class:list={[
        "flex h-11 w-11 items-center justify-center rounded-full transition-all duration-200 active:scale-95",
        isWallet
          ? "bg-[#111827] text-white shadow-sm"
          : "text-[#4B5563] hover:text-[#111827] hover:bg-[#EDEDED]/70"
      ]}
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width={isWallet ? "2.2" : "1.8"}
        stroke-linecap="round"
        stroke-linejoin="round"
        class="h-5 w-5"
      >
        <path d="M21.21 15.89A10 10 0 1 1 8 2.83"></path>
        <path d="M22 12A10 10 0 0 0 12 2v10z"></path>
      </svg>
    </a>
  </div>
</nav>
