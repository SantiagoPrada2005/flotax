{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "flotax",
	"compatibility_date": "2026-09-30",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "flotax-db",
			"database_id": "27e3b8d1-c5f2-4a9c-a331-86dd3798b628",
			"migrations_dir": "drizzle/migrations"
		}
	],
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "32070d6eddef483ead0d5ad03e13529c"
		}
	],
	"vars": {
		"BETTER_AUTH_URL": "https://flotax.innovaweb.pro",
		"EMAIL_DEFAULT_FROM": "FlotaX <notificaciones@flotax.innovaweb.pro>",
		"EMAIL_AUTH_FROM": "FlotaX Seguridad <auth@flotax.innovaweb.pro>",
		"EMAIL_ALERTS_FROM": "FlotaX Alertas <soporte@flotax.innovaweb.pro>",
		"ALERT_DEVELOPER_EMAILS": "dev@flotax.innovaweb.pro",
		"APP_ENV": "development"
	},
	"r2_buckets": [
		{
			"binding": "BUCKET_MULTIMEDIA",
			"bucket_name": "flotax-multimedia"
		}
	],
	"send_email": [
		{
			"name": "EMAIL",
			"allowed_sender_addresses": [
				"auth@flotax.innovaweb.pro",
				"notificaciones@flotax.innovaweb.pro",
				"soporte@flotax.innovaweb.pro"
			]
		}
	],
	"observability": {
		"logs": {
			"invocation_logs": true,
			"enabled": true
		},
	}
}