{
  "name": "flotax",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "astro dev --host",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "node --import ./tests/register-loader.mjs --test tests/*.test.ts",
    "audit:interactions": "node scripts/audit-interactions.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply flotax-db --local",
    "db:migrate:preview": "wrangler d1 migrations apply flotax-db-preview --remote --env preview",
    "db:migrate:remote": "wrangler d1 migrations apply flotax-db --remote",
    "db:migrate:prod": "wrangler d1 migrations apply flotax-db --remote",
    "db:timetravel:info": "wrangler d1 time-travel info flotax-db",
    "db:backup:prod": "mkdir -p backups && wrangler d1 export flotax-db --remote --output=./backups/backup_$(date +%Y%m%d_%H%M%S).sql",
    "db:studio": "drizzle-kit studio",
    "deploy": "astro check && astro build && wrangler deploy",
    "deploy:preview": "astro check && astro build && wrangler deploy --env preview",
    "deploy:prod": "astro check && astro build && wrangler deploy",
    "index:audit": "python3 .agents/skills/codebase-index/scripts/index_manager.py audit",
    "index:tree": "python3 .agents/skills/codebase-index/scripts/index_manager.py tree",
    "index:sync": "python3 .agents/skills/codebase-index/scripts/index_manager.py sync-all",
    "images:optimize": "node scripts/optimize-images.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.7",
    "@astrojs/react": "7.1.8",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "7.4.11",
    "better-auth": "^1.7.21",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "framer-motion": "^14.0.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.49.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@cloudflare/workers-types": "^5.20261110.1",
    "@libsql/client": "^0.18.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.30.6",
    "ffmpeg-static": "^5.3.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "wrangler": "^4.160.1"
  }
}
